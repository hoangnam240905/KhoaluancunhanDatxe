@page
@model AdminWeb.Pages.Pricing.IndexModel
@{ ViewData["Title"] = "Gia loai xe"; }

<div class="d-flex justify-content-between mb-3">
    <h2>Gia loai xe</h2>
    <a asp-page="Create" class="btn btn-primary">Them loai xe</a>
</div>
@if (!string.IsNullOrEmpty(Model.Message)) { <div class="alert alert-info">@Model.Message</div> }
<div class="alert alert-info">
    Giá này áp dụng cho đơn mới. Đơn đã đặt giữ nguyên snapshot.
</div>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Ma</th><th>Loai</th><th>Ngay (TX)</th><th>Km (TX)</th>
            <th>Phi TX/ngay</th><th>Ngay tu lai</th><th>Km gom/ngay</th>
            <th>Km vuot</th><th>Coc TX</th><th>Coc tu lai</th><th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var t in Model.Types)
    {
        <tr>
            <td>#@t.TypeId</td>
            <td>@t.TypeName</td>
            <td>@t.PricePerDay.ToString("N0")</td>
            <td>@t.PricePerKm.ToString("N0")</td>
            <td>@t.DriverFeePerDay.ToString("N0")</td>
            <td>@t.SelfDrivePricePerDay.ToString("N0")</td>
            <td>@t.SelfDriveIncludedKmPerDay.ToString("N0")</td>
            <td>@t.SelfDriveExtraKmPrice.ToString("N0")</td>
            <td>@t.WithDriverDepositAmount.ToString("N0")</td>
            <td>@t.SelfDriveDepositAmount.ToString("N0")</td>
            <td>
                <a asp-page="Edit" asp-route-id="@t.TypeId" class="btn btn-sm btn-outline-primary">Sua gia</a>
                <form method="post" asp-page-handler="Delete" asp-route-id="@t.TypeId" class="d-inline">
                    <button class="btn btn-sm btn-outline-danger">Xoa</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
