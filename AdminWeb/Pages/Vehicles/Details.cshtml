@page "{id:int}"
@model AdminWeb.Pages.Vehicles.DetailsModel
@{ ViewData["Title"] = "Hồ sơ xe"; }

<h2 class="mb-3">🚗 Hồ sơ xe</h2>
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
@if (Model.Profile is null)
{
    @if (!Model.LoadingFailed)
    {
        <p class="text-muted">Đang tải thông tin xe...</p>
    }
}
else
{
    var p = Model.Profile;
    var v = p.Vehicle;
    var handover = p.LatestHandover;
    var ret = p.LatestReturn;
    <div class="mb-3">
        <a asp-page="Index" class="btn btn-secondary btn-sm">Quay lại danh sách</a>
        <a asp-page="Edit" asp-route-id="@v.VehicleId" class="btn btn-outline-primary btn-sm">Sửa</a>
        <a asp-page="Maintenance" asp-route-id="@v.VehicleId" class="btn btn-outline-warning btn-sm">Bảo trì</a>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">🚗 Thông tin xe</h5>
            <div>Biển số: <strong>@v.LicensePlate</strong></div>
            <div>Loại xe: @v.TypeName</div>
            <div>Hãng: @v.Brand</div>
            <div>Model: @v.Model</div>
            <div>Năm: @v.Year</div>
            <div>Số chỗ: @p.SeatCapacity</div>
            <div>Màu: @(string.IsNullOrWhiteSpace(v.Color) ? "—" : v.Color)</div>
            <div>Trạng thái: @UiDisplay.VehicleStatus(v.Status)</div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">📍 Số KM hiện tại</h5>
            <div class="fs-4 fw-semibold">@p.CurrentKm.ToString("N0") km</div>
            <div class="mt-2">Nhiên liệu gần nhất: @(p.LatestFuelLevel is null ? "Chưa có dữ liệu." : $"{p.LatestFuelLevel.Value:N0}%")</div>
            <div>Thời điểm cập nhật: @(p.LastOperationalUpdateAt is null ? "Chưa có dữ liệu." : UiDisplay.Timestamp(p.LastOperationalUpdateAt.Value))</div>
            @if (p.LatestInspection is not null)
            {
                <div class="text-muted">Nguồn: kiểm xe @UiDisplay.InspectionType(p.LatestInspection.InspectionType)</div>
            }
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">🔧 Tình trạng gần nhất</h5>
            @if (p.LatestInspection is null)
            {
                <div class="text-muted">Chưa có dữ liệu kiểm xe.</div>
            }
            else
            {
                <div>Ngoại thất: @(string.IsNullOrWhiteSpace(p.LatestExteriorCondition) ? "Chưa có dữ liệu." : p.LatestExteriorCondition)</div>
                <div>Kỹ thuật: @(string.IsNullOrWhiteSpace(p.LatestTechnicalCondition) ? "Chưa có dữ liệu." : p.LatestTechnicalCondition)</div>
                <div>Ghi chú: @(string.IsNullOrWhiteSpace(p.LatestNotes) ? "Chưa có dữ liệu." : p.LatestNotes)</div>
            }
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">🚗 Kiểm xe lúc bàn giao</h5>
            @if (handover is null)
            {
                <div class="text-muted">Chưa có dữ liệu bàn giao.</div>
            }
            else
            {
                <div>KM: @(handover.OdometerKm is null ? "Chưa có dữ liệu." : $"{handover.OdometerKm.Value:N0} km")</div>
                <div>Nhiên liệu: @(handover.FuelLevel is null ? "Chưa có dữ liệu." : $"{handover.FuelLevel.Value:N0}%")</div>
                <div>Ngoại thất: @(string.IsNullOrWhiteSpace(handover.ExteriorCondition) ? "Chưa có dữ liệu." : handover.ExteriorCondition)</div>
                <div>Kỹ thuật: @(string.IsNullOrWhiteSpace(handover.TechnicalCondition) ? "Chưa có dữ liệu." : handover.TechnicalCondition)</div>
                <div>Ghi chú: @(string.IsNullOrWhiteSpace(handover.Notes) ? "Chưa có dữ liệu." : handover.Notes)</div>
                <div>Thời gian: @UiDisplay.Timestamp(handover.CreatedAt)</div>
            }
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">🔧 Kiểm xe lúc trả</h5>
            @if (ret is null)
            {
                <div class="text-muted">Chưa có dữ liệu trả xe.</div>
            }
            else
            {
                <div>KM: @(ret.OdometerKm is null ? "Chưa có dữ liệu." : $"{ret.OdometerKm.Value:N0} km")</div>
                <div>Nhiên liệu: @(ret.FuelLevel is null ? "Chưa có dữ liệu." : $"{ret.FuelLevel.Value:N0}%")</div>
                <div>Ngoại thất: @(string.IsNullOrWhiteSpace(ret.ExteriorCondition) ? "Chưa có dữ liệu." : ret.ExteriorCondition)</div>
                <div>Kỹ thuật: @(string.IsNullOrWhiteSpace(ret.TechnicalCondition) ? "Chưa có dữ liệu." : ret.TechnicalCondition)</div>
                <div>Ghi chú: @(string.IsNullOrWhiteSpace(ret.Notes) ? "Chưa có dữ liệu." : ret.Notes)</div>
                <div>Thời gian: @UiDisplay.Timestamp(ret.CreatedAt)</div>
            }
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">📊 KM thực tế chuyến gần nhất</h5>
            @if (p.ActualKm is null)
            {
                <div class="text-muted">Chưa có dữ liệu.</div>
            }
            else
            {
                <div class="fs-5 fw-semibold">@p.ActualKm.Value.ToString("N0") km</div>
            }
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">🛠️ Bảo trì</h5>
            <div>Trạng thái: <strong>@p.MaintenanceStatusLabel</strong></div>
            @if (!string.IsNullOrWhiteSpace(p.MaintenanceAlertReason))
            {
                <div class="text-danger">Cảnh báo: @p.MaintenanceAlertReason</div>
            }
            @if (p.OpenMaintenance is not null)
            {
                var open = p.OpenMaintenance;
                <div class="mt-2">Phiếu đang mở: @UiDisplay.MaintenanceType(open.MaintenanceType)</div>
                <div>Trạng thái phiếu: Đang mở</div>
                <div>Ngày hẹn: @UiDisplay.Timestamp(open.ScheduledDate)</div>
                <div>KM lúc bảo trì: @(open.OdometerAtMaintenance is null ? "Chưa có dữ liệu." : $"{open.OdometerAtMaintenance.Value:N0} km")</div>
            }
            @if (p.LatestMaintenance is null)
            {
                <div class="text-muted mt-2">Chưa có lần bảo trì hoàn thành.</div>
            }
            else
            {
                var m = p.LatestMaintenance;
                <div class="mt-2">Lần bảo trì gần nhất: @UiDisplay.MaintenanceType(m.MaintenanceType)</div>
                <div>Trạng thái phiếu: Hoàn thành</div>
                <div>Ngày hẹn: @UiDisplay.Timestamp(m.ScheduledDate)</div>
                <div>Ngày hoàn thành: @(m.CompletedDate is null ? "Chưa có dữ liệu." : UiDisplay.Timestamp(m.CompletedDate.Value))</div>
                <div>KM lúc bảo trì: @(m.OdometerAtMaintenance is null ? "Chưa có dữ liệu." : $"{m.OdometerAtMaintenance.Value:N0} km")</div>
            }
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">📄 Thông tin pháp lý</h5>
            <div>Số đăng ký: @(string.IsNullOrWhiteSpace(v.RegistrationNumber) ? "—" : v.RegistrationNumber)</div>
            <div>Hạn đăng ký: @(v.RegistrationExpiryDate is null ? "—" : v.RegistrationExpiryDate.Value.ToString("dd/MM/yyyy"))</div>
            <div>Hạn đăng kiểm: @(v.InspectionExpiryDate is null ? "—" : v.InspectionExpiryDate.Value.ToString("dd/MM/yyyy"))</div>
            <div>Hạn bảo hiểm: @(v.InsuranceExpiryDate is null ? "—" : v.InsuranceExpiryDate.Value.ToString("dd/MM/yyyy"))</div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Kiểm xe gần đây</h5>
            @if (p.RecentInspections is null || p.RecentInspections.Count == 0)
            {
                <div class="text-muted">Chưa có dữ liệu kiểm xe.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Ngày</th>
                                <th>Loại</th>
                                <th>KM</th>
                                <th>Nhiên liệu</th>
                                <th>Ngoại thất</th>
                                <th>Kỹ thuật</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var i in p.RecentInspections)
                        {
                            <tr>
                                <td>@UiDisplay.Timestamp(i.ActualAt)</td>
                                <td>@UiDisplay.InspectionType(i.InspectionType)</td>
                                <td>@(i.OdometerKm is null ? "—" : $"{i.OdometerKm.Value:N0}")</td>
                                <td>@(i.FuelLevel is null ? "—" : $"{i.FuelLevel.Value:N0}%")</td>
                                <td>@(string.IsNullOrWhiteSpace(i.ExteriorCondition) ? "—" : i.ExteriorCondition)</td>
                                <td>@(string.IsNullOrWhiteSpace(i.TechnicalCondition) ? "—" : i.TechnicalCondition)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}
