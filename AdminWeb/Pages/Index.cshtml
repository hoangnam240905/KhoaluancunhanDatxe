@page
@model AdminWeb.Pages.IndexModel
@{ ViewData["Title"] = "Dashboard"; }
<h2 class="mb-3">Dashboard Admin</h2>
<p class="text-muted">Cọc đã Paid (mô phỏng) — không phải tổng doanh thu thuê xe. Snapshot xe/tài xế không theo from/to.</p>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-3">
        <label class="form-label">Từ (UTC)</label>
        <input class="form-control" type="datetime-local" name="from" value="@(Model.From?.ToString("yyyy-MM-ddTHH:mm"))" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Đến (UTC)</label>
        <input class="form-control" type="datetime-local" name="to" value="@(Model.To?.ToString("yyyy-MM-ddTHH:mm"))" />
    </div>
    <div class="col-md-3">
        <button class="btn btn-primary" type="submit">Lọc</button>
        <a class="btn btn-outline-secondary" asp-page="/Index">Mặc định 30 ngày</a>
    </div>
</form>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
else if (Model.Dashboard is { } d)
{
    <div class="row g-3 mb-3">
        <div class="col-md-3"><div class="card text-bg-primary"><div class="card-body"><h6>Tổng đơn đặt</h6><p class="display-6 mb-0">@d.Summary.TotalBookings</p></div></div></div>
        <div class="col-md-3"><div class="card text-bg-success"><div class="card-body"><h6>Đơn hoàn thành</h6><p class="display-6 mb-0">@d.Summary.CompletedBookings</p></div></div></div>
        <div class="col-md-3"><div class="card text-bg-secondary"><div class="card-body"><h6>Đơn đã hủy</h6><p class="display-6 mb-0">@d.Summary.CancelledBookings</p></div></div></div>
        <div class="col-md-3"><div class="card text-bg-warning"><div class="card-body"><h6>@d.Summary.DepositPaidLabel</h6><p class="display-6 mb-0">@d.Summary.DepositPaidAmount.ToString("N0")</p></div></div></div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h5>Đơn đặt (CreatedAt)</h5>
                    <p class="small text-muted mb-2">Không gọi đây là số chuyến.</p>
                    <ul class="mb-2">
                        <li>Pending: @d.Bookings.Pending</li>
                        <li>Confirmed: @d.Bookings.Confirmed</li>
                        <li>Assigned: @d.Bookings.Assigned</li>
                        <li>InProgress: @d.Bookings.InProgress</li>
                        <li>Completed: @d.Bookings.Completed</li>
                        <li>Cancelled: @d.Bookings.Cancelled</li>
                    </ul>
                    <h6>Chuyến tài xế (TripAssignment)</h6>
                    <ul class="mb-0">
                        <li>Assigned: @d.Bookings.DriverTrips.Assigned</li>
                        <li>Accepted: @d.Bookings.DriverTrips.Accepted</li>
                        <li>InProgress: @d.Bookings.DriverTrips.InProgress</li>
                        <li>Completed: @d.Bookings.DriverTrips.Completed</li>
                        <li>Cancelled: @d.Bookings.DriverTrips.Cancelled</li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h5>@d.Payments.AmountLabel</h5>
                    <p class="small text-muted">@d.Payments.MetricNote</p>
                    <ul class="mb-3">
                        <li>Paid: @d.Payments.PaidDepositCount</li>
                        <li>Pending: @d.Payments.PendingDepositCount</li>
                        <li>Failed: @d.Payments.FailedDepositCount</li>
                    </ul>
                    <h6>Xe (snapshot)</h6>
                    <ul class="mb-3">
                        <li>Available: @d.Vehicles.Available</li>
                        <li>Rented: @d.Vehicles.Rented</li>
                        <li>Maintenance: @d.Vehicles.Maintenance</li>
                        <li>Inactive: @d.Vehicles.Inactive</li>
                    </ul>
                    <h6>Tài xế (snapshot)</h6>
                    <ul class="mb-0">
                        <li>Available: @d.Drivers.Available</li>
                        <li>Busy: @d.Drivers.Busy</li>
                        <li>Offline: @d.Drivers.Offline</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5>Top xe hoàn thành</h5>
                    @if (d.TopVehicles.Count == 0)
                    {
                        <p class="text-muted mb-0">Chưa có đơn/chuyến hoàn thành trong khoảng.</p>
                    }
                    else
                    {
                        <table class="table table-sm mb-0">
                            <thead><tr><th>Xe</th><th>Biển số</th><th>Completed</th></tr></thead>
                            <tbody>
                            @foreach (var v in d.TopVehicles)
                            {
                                <tr>
                                    <td>@v.Brand @v.Model</td>
                                    <td>@v.LicensePlate</td>
                                    <td>@v.CompletedCount</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5>Booking từ gợi ý</h5>
                    <p class="small text-muted">@d.Recommendation.MetricNote</p>
                    <ul class="mb-0">
                        <li>Tổng đơn: @d.Recommendation.TotalBookings</li>
                        <li>Từ gợi ý: @d.Recommendation.RecommendedBookings</li>
                        <li>Chỉ số attribution: @(d.Recommendation.AttributionShare is null ? "—" : (d.Recommendation.AttributionShare.Value * 100).ToString("0.##") + "%")</li>
                        <li>Gợi ý đã hoàn thành: @d.Recommendation.RecommendedCompletedBookings</li>
                        <li>Điểm TB (review đơn gợi ý hoàn thành): @(d.Recommendation.AverageRatingRecommendedReviewed?.ToString("0.00") ?? "Chưa có đánh giá")</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5>Tài xế (runtime assignment / sự cố / review)</h5>
            <p class="small text-muted mb-2">Tỷ lệ hoàn thành assignment = completed / (completed + cancelled). Không phải điểm hiệu suất. Không dùng TotalTrips/AverageRating seed.</p>
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>Tài xế</th>
                        <th>Completed</th>
                        <th>Cancelled</th>
                        <th>Sự cố</th>
                        <th>Rating</th>
                        <th>Tỷ lệ hoàn thành assignment</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in d.Drivers.Performance)
                {
                    <tr>
                        <td>@row.FullName</td>
                        <td>@row.CompletedAssignments</td>
                        <td>@row.CancelledAssignments</td>
                        <td>@row.IncidentCount</td>
                        <td>@(row.AverageReviewRating?.ToString("0.00") ?? "Chưa có đánh giá")</td>
                        <td>@(row.AssignmentCompletionRate is null ? "—" : (row.AssignmentCompletionRate.Value * 100).ToString("0.##") + "%")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5>Cảnh báo bảo trì</h5>
            <p>Số xe cần bảo trì: <strong>@d.Maintenance.AlertCount</strong></p>
            @if (d.Maintenance.Alerts.Count == 0)
            {
                <p class="text-muted mb-0">Không có cảnh báo.</p>
            }
            else
            {
                <table class="table table-sm mb-0">
                    <thead><tr><th>Biển số</th><th>Km since</th><th>Days since</th><th>Lý do</th></tr></thead>
                    <tbody>
                    @foreach (var a in d.Maintenance.Alerts)
                    {
                        <tr>
                            <td>@a.LicensePlate</td>
                            <td>@a.KmSinceLastMaintenance</td>
                            <td>@a.DaysSinceLastMaintenance</td>
                            <td>@a.Reason</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

<div class="mt-4">
    <a asp-page="/Vehicles/Index" class="btn btn-outline-primary me-2">Quan ly xe</a>
    <a asp-page="/Pricing/Index" class="btn btn-outline-primary me-2">Gia loai xe</a>
    <a asp-page="/Drivers/Index" class="btn btn-outline-primary me-2">Tai xe</a>
    <a asp-page="/Customers/Index" class="btn btn-outline-primary me-2">Khach hang</a>
    <a asp-page="/Payments/Index" class="btn btn-outline-primary me-2">Thanh toan</a>
    <a asp-page="/Bookings/Index" class="btn btn-outline-secondary">Quan ly don dat</a>
</div>
