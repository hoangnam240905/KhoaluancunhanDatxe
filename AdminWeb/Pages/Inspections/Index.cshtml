@page
@model AdminWeb.Pages.Inspections.IndexModel
@{ ViewData["Title"] = "Kiem xe"; }

<h2 class="mb-3">Bien ban van hanh</h2>
<p class="text-muted">Chi xem. Tai xe/dieu phoi ghi nhan khi giao/tra xe.</p>
@if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-3"><label class="form-label">Ma don</label><input name="bookingId" value="@Model.FilterBookingId" class="form-control" type="number" min="1" /></div>
    <div class="col-md-6">
        <button type="submit" class="btn btn-primary">Loc</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Xoa loc</a>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Ma</th><th>Don</th><th>Xe</th><th>Loai</th><th>Km</th><th>Nhien lieu</th>
            <th>Ngoai that</th><th>Ky thuat</th><th>Ghi chu</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var i in Model.Inspections)
    {
        <tr>
            <td>#@i.InspectionId</td>
            <td>#@i.BookingId</td>
            <td>#@i.VehicleId</td>
            <td>@i.InspectionType</td>
            <td>@(i.OdometerKm?.ToString("N0") ?? "—")</td>
            <td>@(i.FuelLevel?.ToString("N0") ?? "—")</td>
            <td>@(i.ExteriorCondition ?? i.Condition ?? "—")</td>
            <td>@(i.TechnicalCondition ?? "—")</td>
            <td>@(i.Notes ?? "—")</td>
        </tr>
    }
    </tbody>
</table>
