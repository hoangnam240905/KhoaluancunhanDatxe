@page
@model AdminWeb.Pages.Payments.IndexModel
@{ ViewData["Title"] = "Thanh toan"; }

<h2 class="mb-3">Thanh toan</h2>
<p class="text-muted">Chi xem. Khach mo phong Paid/Failed tren don cua minh. Khong cong thanh toan that.</p>
@if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-2"><label class="form-label">Ma don</label><input name="bookingId" value="@Model.FilterBookingId" class="form-control" type="number" min="1" /></div>
    <div class="col-md-3">
        <label class="form-label">Trang thai</label>
        <select name="status" class="form-select">
            <option value="">Tat ca</option>
            <option value="Pending" selected="@(Model.FilterStatus == "Pending" ? "selected" : null)">Pending</option>
            <option value="Paid" selected="@(Model.FilterStatus == "Paid" ? "selected" : null)">Paid</option>
            <option value="Failed" selected="@(Model.FilterStatus == "Failed" ? "selected" : null)">Failed</option>
            <option value="Refunded" selected="@(Model.FilterStatus == "Refunded" ? "selected" : null)">Refunded</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Loai</label>
        <select name="paymentType" class="form-select">
            <option value="">Tat ca</option>
            <option value="Deposit" selected="@(Model.FilterPaymentType == "Deposit" ? "selected" : null)">Deposit</option>
            <option value="Balance" selected="@(Model.FilterPaymentType == "Balance" ? "selected" : null)">Balance</option>
            <option value="Refund" selected="@(Model.FilterPaymentType == "Refund" ? "selected" : null)">Refund</option>
        </select>
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-primary">Loc</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Xoa loc</a>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Ma</th><th>Don</th><th>So tien</th><th>Loai</th><th>Phuong thuc</th>
            <th>Trang thai</th><th>Ma GD</th><th>PaidAt</th><th>Tao luc</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var p in Model.Payments)
    {
        <tr>
            <td>#@p.PaymentId</td>
            <td>#@p.BookingId</td>
            <td>@p.Amount.ToString("N0")</td>
            <td>@IndexModel.PaymentTypeLabel(p.PaymentType)</td>
            <td>@p.Method</td>
            <td>@p.Status</td>
            <td>@(p.TransactionRef ?? "—")</td>
            <td>@(p.PaidAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
            <td>@p.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
        </tr>
    }
    </tbody>
</table>
