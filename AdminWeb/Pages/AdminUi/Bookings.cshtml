@page "/admin-ui/bookings"
@{
    Layout = "_AdminUiLayout";
    ViewData["Title"] = "Quản lý đơn thuê";
    ViewData["Nav"] = "bookings";
    ViewData["SearchPlaceholder"] = "Tìm mã đơn, khách hàng hoặc xe";
}
<div id="auiBookings">
    <div class="aui-page-head">
        <div>
            <h1>Quản lý đơn thuê</h1>
            <p>Xem và quản lý toàn bộ đơn thuê xe trên hệ thống.</p>
        </div>
        <div class="aui-head-actions">
            <button type="button" class="aui-btn aui-btn-primary" data-new-booking><i class="bi bi-plus-lg"></i> Tạo đơn thuê</button>
        </div>
    </div>

    <div class="aui-kpi-grid cols-5">
        <div class="aui-card aui-kpi">
            <div class="aui-kpi-icon blue"><i class="bi bi-collection"></i></div>
            <div>
                <div class="aui-kpi-label">Tổng đơn thuê</div>
                <div class="aui-kpi-value">1,842</div>
                <div class="aui-kpi-change up">+12.5%</div>
            </div>
        </div>
        <div class="aui-card aui-kpi">
            <div class="aui-kpi-icon amber"><i class="bi bi-hourglass-split"></i></div>
            <div>
                <div class="aui-kpi-label">Chờ xác nhận</div>
                <div class="aui-kpi-value">126</div>
                <div class="aui-kpi-change up">+5.2%</div>
            </div>
        </div>
        <div class="aui-card aui-kpi">
            <div class="aui-kpi-icon purple"><i class="bi bi-arrow-repeat"></i></div>
            <div>
                <div class="aui-kpi-label">Đang thực hiện</div>
                <div class="aui-kpi-value">318</div>
                <div class="aui-kpi-change up">+18.4%</div>
            </div>
        </div>
        <div class="aui-card aui-kpi">
            <div class="aui-kpi-icon green"><i class="bi bi-check2-circle"></i></div>
            <div>
                <div class="aui-kpi-label">Hoàn thành</div>
                <div class="aui-kpi-value">1,294</div>
                <div class="aui-kpi-change up">+20.1%</div>
            </div>
        </div>
        <div class="aui-card aui-kpi">
            <div class="aui-kpi-icon red"><i class="bi bi-x-circle"></i></div>
            <div>
                <div class="aui-kpi-label">Đã hủy</div>
                <div class="aui-kpi-value">104</div>
                <div class="aui-kpi-change down">-8.3%</div>
            </div>
        </div>
    </div>

    <div class="aui-filters">
        <div class="aui-field grow">
            <label>Tìm kiếm</label>
            <input class="aui-input" placeholder="Tìm mã đơn, khách hàng hoặc xe" data-filter-q />
        </div>
        <div class="aui-field">
            <label>Trạng thái</label>
            <select class="aui-select" data-filter-status>
                <option value="">Tất cả trạng thái</option>
                <option value="Pending">Chờ xác nhận</option>
                <option value="Confirmed">Đã xác nhận</option>
                <option value="In Progress">Đang thực hiện</option>
                <option value="Completed">Hoàn thành</option>
                <option value="Cancelled">Đã hủy</option>
            </select>
        </div>
        <div class="aui-field">
            <label>Hình thức thuê</label>
            <select class="aui-select" data-filter-rental>
                <option value="">Tất cả hình thức thuê</option>
                <option value="Self Drive">Tự lái</option>
                <option value="With Driver">Có tài xế</option>
            </select>
        </div>
        <div class="aui-field">
            <label>Khoảng thời gian</label>
            <input class="aui-input" value="14/09 – 14/10/2026" readonly data-aui-toast="Bộ chọn ngày chỉ là giao diện." />
        </div>
        <div class="aui-field" style="align-self:end">
            <button type="button" class="aui-btn aui-btn-ghost" data-export><i class="bi bi-download"></i> Xuất dữ liệu</button>
        </div>
    </div>

    <div class="aui-card">
        <div class="aui-table-wrap">
            <table class="aui-table">
                <thead>
                    <tr>
                        <th><input type="checkbox" data-select-all /></th>
                        <th>#</th>
                        <th>Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Mẫu xe</th>
                        <th>Hình thức thuê</th>
                        <th>Thời gian thuê</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody data-table-body></tbody>
            </table>
        </div>
        <div class="aui-pager" data-pager></div>
    </div>
</div>
