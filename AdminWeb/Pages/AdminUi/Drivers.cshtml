@page "/admin-ui/drivers"
@{
    Layout = "_AdminUiLayout";
    ViewData["Title"] = "Quản lý tài xế";
    ViewData["Nav"] = "drivers";
    ViewData["SearchPlaceholder"] = "Tìm kiếm tài xế";
}
<div id="auiDrivers">
    <div class="aui-page-head">
        <div>
            <h1>Quản lý tài xế</h1>
            <p>Quản lý tài xế, theo dõi hiệu suất và đảm bảo hoạt động vận hành thuận lợi.</p>
        </div>
        <div class="aui-head-actions">
            <button type="button" class="aui-btn aui-btn-primary" data-add-driver><i class="bi bi-plus-lg"></i> Thêm tài xế</button>
        </div>
    </div>

    <div class="aui-kpi-grid">
        <div class="aui-card aui-kpi">
            <div class="aui-kpi-icon blue"><i class="bi bi-person-badge"></i></div>
            <div><div class="aui-kpi-label">Tổng tài xế</div><div class="aui-kpi-value">56</div></div>
        </div>
        <div class="aui-card aui-kpi">
            <div class="aui-kpi-icon green"><i class="bi bi-check-circle"></i></div>
            <div><div class="aui-kpi-label">Có sẵn</div><div class="aui-kpi-value">28</div></div>
        </div>
        <div class="aui-card aui-kpi">
            <div class="aui-kpi-icon amber"><i class="bi bi-lightning-charge"></i></div>
            <div><div class="aui-kpi-label">Đang bận</div><div class="aui-kpi-value">18</div></div>
        </div>
        <div class="aui-card aui-kpi">
            <div class="aui-kpi-icon slate"><i class="bi bi-moon"></i></div>
            <div><div class="aui-kpi-label">Ngoại tuyến</div><div class="aui-kpi-value">10</div></div>
        </div>
    </div>

    <div class="aui-filters">
        <div class="aui-field grow">
            <label>Tìm kiếm</label>
            <input class="aui-input" placeholder="Tìm kiếm tài xế" data-filter-q />
        </div>
        <div class="aui-field">
            <label>Trạng thái</label>
            <select class="aui-select" data-filter-status>
                <option value="">Tất cả trạng thái</option>
                <option value="Available">Có sẵn</option>
                <option value="Busy">Đang bận</option>
                <option value="Offline">Ngoại tuyến</option>
            </select>
        </div>
        <div class="aui-field">
            <label>Khu vực</label>
            <select class="aui-select" data-filter-city>
                <option value="">Tất cả khu vực</option>
                <option value="HCMC">TP. Hồ Chí Minh</option>
                <option value="Hanoi">Hà Nội</option>
                <option value="Da Nang">Đà Nẵng</option>
            </select>
        </div>
        <div class="aui-field" style="align-self:end">
            <button type="button" class="aui-btn aui-btn-ghost" data-export><i class="bi bi-download"></i> Xuất dữ liệu</button>
        </div>
    </div>

    <div class="aui-card">
        <div class="aui-table-wrap">
            <table class="aui-table">
                <thead>
                    <tr>
                        <th><input type="checkbox" data-select-all /></th>
                        <th>#</th>
                        <th>Tài xế</th>
                        <th>Số điện thoại</th>
                        <th>Trạng thái</th>
                        <th>Đánh giá trung bình</th>
                        <th>Tổng chuyến</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody data-table-body></tbody>
            </table>
        </div>
        <div class="aui-pager" data-pager></div>
    </div>
</div>
