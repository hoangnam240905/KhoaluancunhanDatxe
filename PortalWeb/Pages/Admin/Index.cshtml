@page "/Admin"
@model PortalWeb.Pages.Admin.IndexModel
@{ ViewData["Title"] = "Admin Dashboard"; }

<div class="page-header">
    <h2>Dashboard Admin</h2>
    <p>Tổng quan hệ thống cho thuê xe</p>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card stat-card stat-card-primary">
            <div class="card-body">
                <p class="mb-1 opacity-75 small">Xe trong hệ thống</p>
                <p class="display-6 fw-bold mb-0">@Model.VehicleCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card stat-card-success">
            <div class="card-body">
                <p class="mb-1 opacity-75 small">Tổng đơn đặt</p>
                <p class="display-6 fw-bold mb-0">@Model.BookingCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card stat-card-warning">
            <div class="card-body">
                <p class="mb-1 opacity-75 small">Đơn chờ xử lý</p>
                <p class="display-6 fw-bold mb-0">@Model.PendingCount</p>
            </div>
        </div>
    </div>
</div>
<div class="d-flex flex-wrap gap-2">
    <a asp-page="/Admin/Vehicles/Index" class="btn btn-primary">Quản lý xe</a>
    <a asp-page="/Admin/Pricing/Index" class="btn btn-outline-primary">Giá loại xe</a>
    <a asp-page="/Admin/Payments/Index" class="btn btn-outline-primary">Thanh toán</a>
    <a asp-page="/Admin/Bookings/Index" class="btn btn-outline-primary">Quản lý đơn đặt</a>
</div>
