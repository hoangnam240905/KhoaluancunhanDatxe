@page "/Admin/Bookings"
@model PortalWeb.Pages.Admin.Bookings.IndexModel
@{ ViewData["Title"] = "Quản lý đơn"; }

<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div>
        <h2>Quản lý tất cả đơn đặt</h2>
        <p>Xem chi tiết khách hàng, tuyến đi, tài xế và trạng thái</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-info">@Model.Message</div>
}

@if (!Model.Bookings.Any())
{
    <div class="modern-card p-5 text-center text-muted">Chưa có đơn đặt nào.</div>
}
else
{
    <div class="row g-3">
        @foreach (var b in Model.Bookings)
        {
            <div class="col-12">
                <div class="modern-card booking-detail-card p-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                        <div>
                            <div class="fw-bold fs-5">#@b.BookingId · @b.VehicleTypeName</div>
                            <div class="text-muted small">
                                Khách: <strong>@b.CustomerName</strong>
                                · Tạo: @b.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-secondary badge-status">@b.Status</span>
                            @if (b.Status is "Pending" or "Confirmed")
                            {
                                <form method="post" asp-page-handler="Cancel" asp-route-id="@b.BookingId" class="d-inline">
                                    <button class="btn btn-sm btn-outline-danger">Hủy đơn</button>
                                </form>
                            }
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-5">
                            <div class="detail-label">Tuyến đi</div>
                            <div class="fw-semibold">@b.PickupAddress → @b.DropoffAddress</div>
                        </div>
                        <div class="col-md-4">
                            <div class="detail-label">Thời gian</div>
                            <div>@b.StartDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm") → @b.EndDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                        <div class="col-md-3">
                            <div class="detail-label">Cước phí</div>
                            <div class="fw-bold text-primary">@b.TotalAmount.ToString("N0") VND</div>
                            @if (b.EstimatedDistance is not null)
                            {
                                <div class="small text-muted">~@b.EstimatedDistance km</div>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(b.Notes))
                    {
                        <div class="mt-3">
                            <div class="detail-label">Ghi chú</div>
                            <div>@b.Notes</div>
                        </div>
                    }

                    <div class="driver-box mt-4">
                        @if (b.Assignment is null)
                        {
                            <div class="text-muted"><strong>Tài xế:</strong> Chưa phân công</div>
                        }
                        else
                        {
                            <div class="row g-2">
                                <div class="col-md-3">
                                    <div class="detail-label">Tài xế</div>
                                    <div class="fw-bold">@b.Assignment.DriverName</div>
                                </div>
                                <div class="col-md-3">
                                    <div class="detail-label">SĐT tài xế</div>
                                    <div>@(string.IsNullOrWhiteSpace(b.Assignment.DriverPhone) ? "—" : b.Assignment.DriverPhone)</div>
                                </div>
                                <div class="col-md-2">
                                    <div class="detail-label">Biển số</div>
                                    <div class="fw-semibold">@b.Assignment.LicensePlate</div>
                                </div>
                                <div class="col-md-2">
                                    <div class="detail-label">TT phân công</div>
                                    <span class="badge bg-info text-dark">@b.Assignment.Status</span>
                                </div>
                                <div class="col-md-2">
                                    <div class="detail-label">Gán lúc</div>
                                    <div class="small">@b.Assignment.AssignedAt.ToLocalTime().ToString("dd/MM HH:mm")</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
