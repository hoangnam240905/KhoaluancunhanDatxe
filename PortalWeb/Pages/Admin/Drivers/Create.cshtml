@page "/Admin/Drivers/Create"
@model PortalWeb.Pages.Admin.Drivers.CreateModel
@{ ViewData["Title"] = "Thêm tài xế"; }
<h2 class="mb-3">Thêm tài xế</h2>
@if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }
<form method="post" class="row g-3 col-md-8">
    <div class="col-md-6"><label class="form-label">Họ tên</label><input asp-for="Input.FullName" class="form-control" /></div>
    <div class="col-md-6"><label class="form-label">Email</label><input asp-for="Input.Email" class="form-control" /></div>
    <div class="col-md-6"><label class="form-label">Số điện thoại</label><input asp-for="Input.Phone" class="form-control" /></div>
    <div class="col-md-6"><label class="form-label">Mật khẩu</label><input asp-for="Input.Password" class="form-control" /></div>
    <div class="col-12"><button type="submit" class="btn btn-primary">Tạo</button> <a asp-page="Index" class="btn btn-secondary">Hủy</a></div>
</form>
