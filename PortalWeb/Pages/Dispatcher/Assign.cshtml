@page "/Dispatcher/Assign/{id:int}"
@model PortalWeb.Pages.Dispatcher.AssignModel
@{ ViewData["Title"] = "Phân công"; }
<h2 class="mb-3">Phân công đơn #@Model.Booking?.BookingId</h2>
@if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }
<form method="post" class="col-md-6">
    <div class="mb-3"><label class="form-label">Tài xế</label><select asp-for="Input.DriverId" class="form-select">@foreach (var d in Model.Drivers) { <option value="@d.DriverId">@d.FullName</option> }</select></div>
    <div class="mb-3"><label class="form-label">Xe</label><select asp-for="Input.VehicleId" class="form-select">@foreach (var v in Model.Vehicles) { <option value="@v.VehicleId">@v.LicensePlate - @v.TypeName</option> }</select></div>
    <button type="submit" class="btn btn-primary">Phân công</button>
    <a asp-page="/Dispatcher/Index" class="btn btn-secondary">Quay lại</a>
</form>
