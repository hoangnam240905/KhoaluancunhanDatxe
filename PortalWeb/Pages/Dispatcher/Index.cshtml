@page "/Dispatcher"
@model PortalWeb.Pages.Dispatcher.IndexModel
@{ ViewData["Title"] = "Điều phối"; }

<div class="page-header">
    <h2>Bảng điều phối</h2>
    <p>Xác nhận đơn đặt và phân công chuyến đi</p>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success">@Model.Message</div>
}

<div class="modern-card p-4 mb-4">
    <h5 class="fw-bold text-warning mb-3">Đơn chờ xác nhận (@Model.PendingBookings.Count)</h5>
    @if (!Model.PendingBookings.Any())
    {
        <p class="text-muted mb-0">Không có đơn pending.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Mã</th>
                        <th>Khách</th>
                        <th>Loại xe</th>
                        <th>Hình thức</th>
                        <th>Thời gian</th>
                        <th>Trạng thái</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var b in Model.PendingBookings)
                {
                    <tr>
                        <td class="fw-semibold">#@b.BookingId</td>
                        <td>@b.CustomerName</td>
                        <td>@b.VehicleTypeName</td>
                        <td>@IndexModel.RentalModeLabel(b.RentalMode)</td>
                        <td>@UiDisplay.Rental(b.StartDate) → @UiDisplay.Rental(b.EndDate)</td>
                        <td>@UiDisplay.BookingStatus(b.Status)</td>
                        <td>
                            <form method="post" asp-page-handler="Confirm" asp-route-id="@b.BookingId" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-3">Xác nhận</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="modern-card p-4 mb-4">
    <h5 class="fw-bold text-primary mb-3">Đơn cần phân công (@Model.ConfirmedBookings.Count)</h5>
    @if (!Model.ConfirmedBookings.Any())
    {
        <p class="text-muted mb-0">Không có đơn cần phân công.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Mã</th>
                        <th>Khách</th>
                        <th>Loại xe</th>
                        <th>Hình thức</th>
                        <th>Thời gian</th>
                        <th>Trạng thái</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var b in Model.ConfirmedBookings)
                {
                    <tr>
                        <td class="fw-semibold">#@b.BookingId</td>
                        <td>@b.CustomerName</td>
                        <td>@b.VehicleTypeName</td>
                        <td>@IndexModel.RentalModeLabel(b.RentalMode)</td>
                        <td>@UiDisplay.Rental(b.StartDate) → @UiDisplay.Rental(b.EndDate)</td>
                        <td>@UiDisplay.BookingStatus(b.Status)</td>
                        <td><a asp-page="/Dispatcher/Assign" asp-route-id="@b.BookingId" class="btn btn-sm btn-primary rounded-pill px-3">Phân công</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="modern-card p-4 mb-4">
    <h5 class="fw-bold text-info mb-3">Tự lái — chờ giao xe (@Model.SelfDriveAssigned.Count)</h5>
    @if (!Model.SelfDriveAssigned.Any())
    {
        <p class="text-muted mb-0">Không có đơn tự lái chờ giao xe.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Mã</th>
                        <th>Khách</th>
                        <th>Loại xe</th>
                        <th>Xe đã gán</th>
                        <th>Thời gian</th>
                        <th>Trạng thái</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var b in Model.SelfDriveAssigned)
                {
                    <tr>
                        <td class="fw-semibold">#@b.BookingId</td>
                        <td>@b.CustomerName</td>
                        <td>@b.VehicleTypeName</td>
                        <td>@(b.AssignedVehicle?.LicensePlate ?? "—")</td>
                        <td>@UiDisplay.Rental(b.StartDate) → @UiDisplay.Rental(b.EndDate)</td>
                        <td>@UiDisplay.BookingStatus(b.Status)</td>
                        <td>
                            <a asp-page="/Dispatcher/Handover" asp-route-id="@b.BookingId" class="btn btn-sm btn-info rounded-pill px-3">Giao xe</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="modern-card p-4 mb-4">
    <h5 class="fw-bold text-success mb-3">Tự lái — đang thuê (@Model.SelfDriveInProgress.Count)</h5>
    @if (!Model.SelfDriveInProgress.Any())
    {
        <p class="text-muted mb-0">Không có đơn tự lái đang thuê.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Mã</th>
                        <th>Khách</th>
                        <th>Loại xe</th>
                        <th>Xe đã gán</th>
                        <th>Thời gian</th>
                        <th>Trạng thái</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var b in Model.SelfDriveInProgress)
                {
                    <tr>
                        <td class="fw-semibold">#@b.BookingId</td>
                        <td>@b.CustomerName</td>
                        <td>@b.VehicleTypeName</td>
                        <td>@(b.AssignedVehicle?.LicensePlate ?? "—")</td>
                        <td>@UiDisplay.Rental(b.StartDate) → @UiDisplay.Rental(b.EndDate)</td>
                        <td>@UiDisplay.BookingStatus(b.Status)</td>
                        <td>
                            <a asp-page="/Dispatcher/Complete" asp-route-id="@b.BookingId" class="btn btn-sm btn-success rounded-pill px-3">Tiếp nhận trả xe</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="modern-card p-4 mb-4">
    <h5 class="fw-bold mb-3">📊 Tình trạng xe &amp; tài xế</h5>
    <p class="text-muted small mb-3">Trạng thái lấy từ Backend. SelfDrive không gắn tài xế; WithDriver hiện tài xế của assignment đang mở.</p>
    @if (!Model.Fleet.Vehicles.Any())
    {
        <p class="text-muted mb-0">Không có dữ liệu xe.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Biển số</th>
                        <th>Loại xe</th>
                        <th>Trạng thái xe</th>
                        <th>Tài xế hiện tại</th>
                        <th>Trạng thái tài xế</th>
                        <th>Chuyến</th>
                        <th>Thời gian</th>
                        <th>Hình thức</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var v in Model.Fleet.Vehicles)
                {
                    <tr>
                        <td class="fw-semibold">@v.LicensePlate</td>
                        <td>@v.TypeName</td>
                        <td>@UiDisplay.VehicleStatus(v.VehicleStatus)</td>
                        <td>@(v.DriverName ?? "—")</td>
                        <td>@(string.IsNullOrEmpty(v.DriverStatus) ? "—" : UiDisplay.DriverStatus(v.DriverStatus))</td>
                        <td>@(v.BookingId is int bid ? $"#{bid}" : "—")</td>
                        <td>
                            @if (v.StartDate is DateTime start && v.EndDate is DateTime end)
                            {
                                @UiDisplay.Rental(start) <text>→</text> @UiDisplay.Rental(end)
                            }
                            else
                            {
                                <text>—</text>
                            }
                        </td>
                        <td>@UiDisplay.RentalMode(v.RentalMode)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="modern-card p-4">
    <h5 class="fw-bold mb-3">Tài xế</h5>
    @if (!Model.Fleet.Drivers.Any())
    {
        <p class="text-muted mb-0">Không có dữ liệu tài xế.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Tài xế</th>
                        <th>Trạng thái</th>
                        <th>Hoạt động</th>
                        <th>Xe hiện tại</th>
                        <th>Chuyến</th>
                        <th>Thời gian</th>
                        <th>Hình thức</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var d in Model.Fleet.Drivers)
                {
                    <tr>
                        <td class="fw-semibold">@d.FullName</td>
                        <td>@UiDisplay.DriverStatus(d.DriverStatus)</td>
                        <td>@(d.IsActive ? "Có" : "Không")</td>
                        <td>@(d.LicensePlate ?? "—")</td>
                        <td>@(d.BookingId is int did ? $"#{did}" : "—")</td>
                        <td>
                            @if (d.StartDate is DateTime start && d.EndDate is DateTime end)
                            {
                                @UiDisplay.Rental(start) <text>→</text> @UiDisplay.Rental(end)
                            }
                            else
                            {
                                <text>—</text>
                            }
                        </td>
                        <td>@UiDisplay.RentalMode(d.RentalMode)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
