@inject PortalWeb.Services.AuthSession Auth
@{
    var nav = ViewData["Nav"] as string ?? "";
    var dashMeta = ViewData["DashMeta"] as bool? == true;
    string NavClass(string key) => nav == key ? "mk-nav-link is-on" : "mk-nav-link";
    var displayName = string.IsNullOrWhiteSpace(Auth.FullName) ? "Điều phối viên" : Auth.FullName!;
    var initials = string.IsNullOrWhiteSpace(Auth.FullName)
        ? "DP"
        : string.Concat(Auth.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Điều phối") — DriveX Mockup</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/mockup-hub.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mockup-notifications.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="mk-body">
    <div class="mk-shell">
        <aside class="mk-sidebar">
            <a class="mk-brand" asp-page="/Mockup/Index">
                <span class="mk-brand-mark"><i class="bi bi-car-front-fill"></i></span>
                <span>
                    DriveX
                    <small>Điều phối</small>
                </span>
            </a>
            <nav class="mk-nav">
                <a class="@NavClass("dashboard")" asp-page="/Mockup/Index"><i class="bi bi-grid-1x2"></i> Tổng quan</a>
                <a class="@NavClass("hub")" asp-page="/Mockup/Hub"><i class="bi bi-clipboard-check"></i> Đặt thuê &amp; Xác nhận</a>
                <a class="@NavClass("schedule")" asp-page="/Mockup/Schedule"><i class="bi bi-calendar3"></i> Lịch xe &amp; tài xế</a>
                <a class="@NavClass("trips")" asp-page="/Mockup/Trips"><i class="bi bi-signpost-2"></i> Vận hành chuyến</a>
                <a class="@NavClass("inspections")" asp-page="/Mockup/Inspections"><i class="bi bi-journal-check"></i> Biên bản kiểm xe</a>
                <a class="@NavClass("notifications")" asp-page="/Mockup/Notifications"><i class="bi bi-bell"></i> Thông báo</a>
                <a class="@NavClass("settings")" asp-page="/Mockup/Settings"><i class="bi bi-gear"></i> Cài đặt tài khoản</a>
            </nav>
            <p class="mk-sidebar-note">Giao diện mô phỏng — chưa kết nối hệ thống</p>
        </aside>
        <div class="mk-main">
            <header class="mk-topbar">
                <button type="button" class="mk-menu-btn" data-mk-toggle aria-label="Mở menu"><i class="bi bi-list"></i></button>
                <a class="mk-top-logo" asp-page="/Mockup/Index">
                    <span class="mk-brand-mark sm"><i class="bi bi-car-front-fill"></i></span>
                    DriveX
                </a>
                <div class="mk-topbar-spacer"></div>
                @if (dashMeta)
                {
                    <div class="dash-meta">
                        <span>Thứ Hai, 15 tháng 09, 2026</span>
                        <span>Nhiệt độ 28°C</span>
                        <span>TP. Hồ Chí Minh</span>
                    </div>
                }
                <div class="nt-bell-wrap">
                    <button type="button" class="mk-icon-btn" id="mkNotifyBtn" title="Thông báo" aria-expanded="false">
                        <i class="bi bi-bell"></i>
                        <span class="mk-dot" id="mkNotifyDot">8</span>
                    </button>
                    <div class="nt-drop" id="mkNotifyDrop" hidden>
                        <div class="nt-drop-head">
                            <strong>Thông báo</strong>
                            <span class="mk-muted" id="mkNotifyDropMeta">8 thông báo chưa đọc</span>
                        </div>
                        <div id="mkNotifyDropList"></div>
                        <a class="nt-drop-all" asp-page="/Mockup/Notifications">Xem tất cả thông báo</a>
                    </div>
                </div>
                <div class="dropdown mk-user-drop">
                    <a class="mk-user" href="#" data-bs-toggle="dropdown" aria-expanded="false" title="@Auth.Email">
                        <span class="mk-avatar">@initials</span>
                        <span>
                            <strong>@displayName</strong>
                            <small>Điều phối viên</small>
                        </span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" asp-page="/Mockup/Settings">Cài đặt tài khoản</a></li>
                        <li><a class="dropdown-item" asp-page="/Account/ChangePassword">Đổi mật khẩu</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item" asp-page="/Account/Logout">Đăng xuất</a></li>
                    </ul>
                </div>
            </header>
            <main class="mk-content">@RenderBody()</main>
        </div>
    </div>
    <div class="mk-backdrop" data-mk-backdrop></div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.querySelector("[data-mk-toggle]")?.addEventListener("click", () => document.body.classList.toggle("mk-nav-open"));
        document.querySelector("[data-mk-backdrop]")?.addEventListener("click", () => document.body.classList.remove("mk-nav-open"));
    </script>
    @await RenderSectionAsync("Scripts", required: false)
    <div class="mk-toast" id="mkGlobalToast"></div>
    <script src="~/js/mockup-notifications.js" asp-append-version="true"></script>
</body>
</html>
