@page
@model PortalWeb.Pages.Mockup.TripsModel
@{
    Layout = "_MockupLayout";
    ViewData["Title"] = "Vận hành chuyến";
    ViewData["Nav"] = "trips";
}
@if (!string.IsNullOrEmpty(Model.LoadError))
{
    <div class="alert alert-warning">@Model.LoadError</div>
}
else
{
    <div class="mk-banner">Vận hành chuyến — theo dõi và xử lý các chuyến thuê xe đang vận hành. Dữ liệu cập nhật từ Backend (bookings, inspections, incidents, fleet-status).</div>
}

<div class="mk-metrics op-metrics" id="opMetrics" data-source="api">
    <button type="button" class="mk-metric is-clickable" data-metric="today">
        <i class="op-metric-icon is-blue bi bi-calendar3"></i>
        <span class="op-metric-text"><span>Chuyến hôm nay</span><strong id="opMetricToday">@Model.MetricToday</strong></span>
        <i class="op-metric-chevron bi bi-chevron-right"></i>
    </button>
    <button type="button" class="mk-metric is-clickable" data-metric="waiting">
        <i class="op-metric-icon is-amber bi bi-clock"></i>
        <span class="op-metric-text"><span>Chờ nhận xe</span><strong id="opMetricWaiting">@Model.MetricWaiting</strong></span>
        <i class="op-metric-chevron bi bi-chevron-right"></i>
    </button>
    <button type="button" class="mk-metric is-clickable" data-metric="running">
        <i class="op-metric-icon is-green bi bi-play-fill"></i>
        <span class="op-metric-text"><span>Đang thực hiện</span><strong id="opMetricInProgress">@Model.MetricInProgress</strong></span>
        <i class="op-metric-chevron bi bi-chevron-right"></i>
    </button>
    <button type="button" class="mk-metric is-clickable" data-metric="incident">
        <i class="op-metric-icon is-red bi bi-exclamation-triangle-fill"></i>
        <span class="op-metric-text"><span>Có sự cố</span><strong id="opMetricIncidents">@Model.MetricIncidents</strong></span>
        <i class="op-metric-chevron bi bi-chevron-right"></i>
    </button>
    <button type="button" class="mk-metric is-clickable" data-metric="settle">
        <i class="op-metric-icon is-amber bi bi-receipt"></i>
        <span class="op-metric-text"><span>Chờ quyết toán</span><strong id="opMetricSettlement">@Model.MetricSettlement</strong></span>
        <i class="op-metric-chevron bi bi-chevron-right"></i>
    </button>
</div>
<section class="mk-card mk-toolbar">
    <h2>Tìm kiếm &amp; bộ lọc</h2>
    <form id="opFilter" class="op-filter-grid" autocomplete="off">
        <label class="mk-field">
            <span>Tìm kiếm</span>
            <input type="search" name="q" placeholder="Tìm mã đơn, khách hàng, xe..." />
        </label>
        <label class="mk-field">
            <span>Trạng thái</span>
            <select name="status">
                <option value="">Tất cả</option>
                <option value="waitingHandover">Chờ giao xe</option>
                <option value="handedOver">Đã giao xe</option>
                <option value="accepted">Đã nhận chuyến</option>
                <option value="inProgress">Đang thực hiện</option>
                <option value="returning">Đang trả xe</option>
                <option value="completed">Hoàn thành</option>
                <option value="incident">Có sự cố</option>
            </select>
        </label>
        <label class="mk-field">
            <span>Hình thức</span>
            <select name="mode">
                <option value="">Tất cả</option>
                <option value="SelfDrive">Tự lái</option>
                <option value="WithDriver">Có tài xế</option>
            </select>
        </label>
        <label class="mk-field">
            <span>Tài xế</span>
            <select name="dstatus">
                <option value="">Tất cả</option>
                <option value="Available">Khả dụng</option>
                <option value="Busy">Đang bận</option>
            </select>
        </label>
        <label class="mk-field">
            <span>Xe</span>
            <select name="vehicle" id="opVehicleFilter">
                <option value="">Tất cả</option>
            </select>
        </label>
        <div class="mk-toolbar-actions">
            <button type="submit" class="mk-btn mk-btn-primary">🔍 Tìm kiếm</button>
            <button type="reset" class="mk-btn mk-btn-ghost" id="opReset">↻ Đặt lại</button>
        </div>
    </form>
</section>

<div class="op-ops-grid">
    <section class="mk-card op-queue-card">
        <div class="op-card-head">
            <h2><i class="bi bi-clipboard-check"></i> Hàng đợi hành động <span class="op-count" id="opQueueCount" hidden></span></h2>
            <a href="#opTableCard" class="op-link" data-scroll-table>Xem tất cả trong bảng <i class="bi bi-arrow-down"></i></a>
        </div>
        <div id="opQueue"></div>
    </section>
    <section class="mk-card op-timeline-card">
        <div class="op-card-head">
            <h2><i class="bi bi-clock-history"></i> Timeline ca hôm nay</h2>
            <span class="mk-muted" id="opTimelineDate"></span>
        </div>
        <div id="opTimeline"></div>
    </section>
</div>
<section class="mk-card sch-board-card" id="opTableCard">
    <div class="sch-board-title">
        <h2><i class="bi bi-list-ul"></i> Danh sách chuyến</h2>
        <p class="mk-muted" id="opTableMeta"></p>
    </div>
    <div class="mk-table-wrap op-table-wrap">
        <table class="mk-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Khách hàng</th>
                    <th>Xe</th>
                    <th>Tài xế</th>
                    <th>Điểm đón</th>
                    <th>Điểm trả</th>
                    <th>Bắt đầu</th>
                    <th>Kết thúc</th>
                    <th>Trạng thái</th>
                    <th>Quyết toán</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody id="opTableBody"></tbody>
        </table>
    </div>
    <div class="op-pager" id="opPager"></div>
</section>

<aside class="mk-drawer op-drawer" id="opDrawer" aria-hidden="true"></aside>
<div class="mk-modal" id="opModal" hidden>
    <div class="mk-modal-dialog" id="opModalBody"></div>
</div>
<div class="mk-toast" id="opToast"></div>

@section Scripts {
    <form id="opAntiForgery" class="d-none">@Html.AntiForgeryToken()</form>
    <script>
        window.__TRIPS_BOOTSTRAP__ = @Html.Raw(Model.BootstrapJson);
        window.__TRIPS_READY__ = @(Model.HasBootstrap ? "true" : "false");
        window.__TRIPS_HANDLERS__ = {
            reload: '@Url.Page("/Mockup/Trips", "Reload")',
            detail: '@Url.Page("/Mockup/Trips", "Detail")',
            handover: '@Url.Page("/Mockup/Trips", "Handover")',
            handoverInfo: '@Url.Page("/Mockup/Trips", "HandoverInfo")',
            complete: '@Url.Page("/Mockup/Trips", "Complete")',
            returnInfo: '@Url.Page("/Mockup/Trips", "ReturnInfo")'
        };
    </script>
    <script src="~/js/mockup-trips.js" asp-append-version="true"></script>
}
