@page
@model PortalWeb.Pages.Mockup.ScheduleModel
@{
    Layout = "_MockupLayout";
    ViewData["Title"] = "Lịch xe & tài xế";
    ViewData["Nav"] = "schedule";
}
@if (!string.IsNullOrEmpty(Model.LoadError))
{
    <div class="alert alert-warning">@Model.LoadError</div>
}

<section class="mk-hub-head">
    <div>
        <h1>Trạng thái đội xe</h1>
        <p>Xe và tài xế trống / có lịch theo ngày, theo tuần — gom theo số chỗ</p>
    </div>
    <div class="sch-head-actions">
        <button type="button" class="mk-btn mk-btn-ghost" id="schToday">📅 Hôm nay</button>
        <label class="mk-field sch-date-field">
            <span>Ngày</span>
            <input type="date" id="schDate" />
        </label>
    </div>
</section>

<div class="dx-metrics" id="schMetrics"></div>

<section class="mk-card dx-pending" id="schPending" hidden>
    <div class="dx-pending-head">
        <h2>⏳ Đơn chờ phân công <span class="mk-badge mk-badge-pending" id="schPendingCount">0</span></h2>
        <p class="mk-muted">Bấm "Xem xe trống" để lọc nhóm xe phù hợp trong đúng khoảng thời gian của đơn.</p>
    </div>
    <div id="schPendingList"></div>
</section>

<section class="mk-card dx-toolbar">
    <div class="dx-toolbar-top">
        <div class="dx-tabs" id="schResource" role="tablist" aria-label="Loại lịch">
            <button type="button" class="dx-tab is-on" data-res="vehicle">🚗 Xe</button>
            <button type="button" class="dx-tab" data-res="driver">👨‍✈️ Tài xế</button>
        </div>
        <div class="dx-tabs" id="schView" role="tablist" aria-label="Chế độ xem">
            <button type="button" class="dx-tab" data-view="day">Ngày</button>
            <button type="button" class="dx-tab is-on" data-view="week">Tuần</button>
            <button type="button" class="dx-tab" data-view="list">Danh sách</button>
        </div>
        <div class="sch-nav dx-nav">
            <button type="button" class="mk-btn mk-btn-ghost" id="schPrev" aria-label="Trước">‹</button>
            <strong id="schRange">Đang tải…</strong>
            <button type="button" class="mk-btn mk-btn-ghost" id="schNext" aria-label="Sau">›</button>
            <button type="button" class="mk-btn mk-btn-primary" id="schThis">Tuần này</button>
        </div>
    </div>
    <div class="dx-filter-row">
        <label class="mk-field dx-filter-q">
            <span>Tìm kiếm</span>
            <input type="search" id="fltQ" placeholder="Biển số, tên xe, tài xế, mã đơn, khách" autocomplete="off" />
        </label>
        <label class="mk-field" data-only="vehicle">
            <span>Số chỗ</span>
            <select id="fltSeats"><option value="">Tất cả</option></select>
        </label>
        <label class="mk-field" data-only="vehicle">
            <span>Loại xe</span>
            <select id="fltModel"><option value="">Tất cả</option></select>
        </label>
        <label class="dx-check">
            <input type="checkbox" id="fltFreeOnly" />
            <span id="fltFreeLabel">Chỉ xe trống trong khoảng đang xem</span>
        </label>
        <button type="button" class="mk-btn mk-btn-ghost" id="fltReset">↻ Đặt lại</button>
    </div>
    <div class="dx-focus-note" id="schFocusNote" hidden></div>
</section>

<section class="mk-card sch-conflict-card" id="schConflictBox" hidden>
    <h2>⚠️ Lịch có xung đột</h2>
    <div id="schConflictList"></div>
</section>

<section class="mk-card dx-board">
    <div class="dx-board-title" id="schBoardTitle"></div>
    <div class="dx-legend" id="schLegend">
        <span><i class="dx-swatch is-free"></i> Trống</span>
        <span><i class="dx-swatch is-busy"></i> Có lịch</span>
        <span><i class="dx-swatch is-partial"></i> Có lịch một phần</span>
        <span><i class="dx-swatch is-buffer"></i> Đệm kỹ thuật 2 giờ</span>
        <span><i class="dx-swatch is-conflict"></i> Xung đột</span>
        <span><i class="dx-swatch is-off"></i> Bảo trì / Ngoại tuyến</span>
        <span><i class="dx-swatch is-done"></i> Đã hoàn thành</span>
    </div>
    <div class="dx-scroll" id="schGrid"></div>
</section>

<aside class="mk-drawer" id="schDrawer" aria-hidden="true"></aside>
<div class="mk-toast" id="schToast"></div>

@section Scripts {
    <form id="schAntiForgery" class="d-none">@Html.AntiForgeryToken()</form>
    <script>
        window.__SCHEDULE_BOOTSTRAP__ = @Html.Raw(Model.BootstrapJson);
        window.__SCHEDULE_HANDLERS__ = {
            reload: '@Url.Page("/Mockup/Schedule", "Reload")',
            assignable: '@Url.Page("/Mockup/Schedule", "Assignable")',
            assign: '@Url.Page("/Mockup/Schedule", "Assign")'
        };
        window.__SCHEDULE_READY__ = @(Model.HasBootstrap ? "true" : "false");
    </script>
    <script src="~/js/mockup-schedule.js" asp-append-version="true"></script>
}
