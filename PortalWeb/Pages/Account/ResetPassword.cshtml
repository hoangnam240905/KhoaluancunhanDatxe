@page
@model PortalWeb.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    ViewData["AuthShell"] = true;
    Layout = "_LayoutAuth";
    var otpError = ViewData.ModelState["Input.Otp"]?.Errors.Count > 0 || !string.IsNullOrEmpty(Model.ErrorMessage);
}

<div class="ax-register">
    <div class="ax-register-bg">
        <img src="~/images/auth/register.jpg" alt="Trải nghiệm DriveX" />
    </div>
    <div class="ax-card">
        <div class="ax-card-top">
            <a class="ax-brand" asp-page="/Index" style="color:#0f1f3d">
                <span><i class="bi bi-car-front-fill"></i></span>
                DriveX
            </a>
            <span class="ax-lang" title="Chỉ hiển thị giao diện tiếng Việt"><i class="bi bi-globe2"></i> Tiếng Việt</span>
        </div>

        <h1>Đặt lại mật khẩu mới</h1>
        <p class="ax-lead">Tạo mật khẩu mới để tiếp tục trải nghiệm cùng DriveX.</p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="ax-alert">@Model.ErrorMessage</div>
        }
        @if (!string.IsNullOrEmpty(Model.InfoMessage))
        {
            <div class="ax-success">@Model.InfoMessage</div>
        }
        <div asp-validation-summary="ModelOnly" class="ax-alert"></div>

        <form method="post" data-ax-form>
            <div class="ax-field">
                <label asp-for="Input.Email">Địa chỉ Email</label>
                <div class="ax-icon-field">
                    <i class="bi bi-envelope"></i>
                    <input asp-for="Input.Email" type="email" placeholder="Nhập email của bạn" autocomplete="username" />
                </div>
                <span asp-validation-for="Input.Email" class="field-validation-error"></span>
            </div>
            <div class="ax-field">
                <label asp-for="Input.Otp">Mã xác thực</label>
                <div class="ax-otp@(otpError ? " is-error" : "")" data-ax-otp>
                    @for (var i = 1; i <= 6; i++)
                    {
                        <input type="text" inputmode="numeric" maxlength="1" pattern="[0-9]*" autocomplete="@(i == 1 ? "one-time-code" : "off")" aria-label="Chữ số @i" />
                    }
                </div>
                <input asp-for="Input.Otp" class="ax-otp-value" data-ax-otp-value maxlength="6" inputmode="numeric" />
                <span asp-validation-for="Input.Otp" class="field-validation-error"></span>
            </div>
            <div class="ax-field">
                <label asp-for="Input.NewPassword">Mật khẩu mới</label>
                <div class="ax-wrap">
                    <input asp-for="Input.NewPassword" id="reset-password" type="password" placeholder="Nhập mật khẩu mới" autocomplete="new-password" />
                    <button type="button" class="ax-toggle" aria-label="Hiện mật khẩu"><i class="bi bi-eye"></i></button>
                </div>
                <div class="ax-strength" data-ax-strength><span></span></div>
                <div class="ax-strength-meta" data-ax-strength-label></div>
                <span asp-validation-for="Input.NewPassword" class="field-validation-error"></span>
                <ul class="ax-rules password-rules">
                    <li id="rule-length">Ít nhất 8 ký tự</li>
                    <li id="rule-upper">Bao gồm chữ hoa, chữ thường và số</li>
                    <li id="rule-special">Bao gồm ít nhất 1 ký tự đặc biệt</li>
                </ul>
            </div>
            <div class="ax-field">
                <label asp-for="Input.ConfirmPassword">Xác nhận mật khẩu</label>
                <div class="ax-wrap">
                    <input asp-for="Input.ConfirmPassword" type="password" placeholder="Nhập lại mật khẩu" autocomplete="new-password" />
                    <button type="button" class="ax-toggle" aria-label="Hiện mật khẩu"><i class="bi bi-eye"></i></button>
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="field-validation-error"></span>
            </div>
            <button type="submit" class="ax-submit" data-ax-submit>Cập nhật mật khẩu</button>
        </form>

        <div class="ax-nav">
            <a class="ax-back" asp-page="/Account/ForgotPassword"><i class="bi bi-arrow-left"></i> Quay lại</a>
            <a class="ax-signin" asp-page="/Account/Login">Đăng nhập ngay</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
