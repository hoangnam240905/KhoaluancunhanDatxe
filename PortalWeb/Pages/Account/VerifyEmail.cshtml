@page
@model PortalWeb.Pages.Account.VerifyEmailModel
@{
    ViewData["Title"] = "Xác minh email";
    Layout = "_LayoutAuth";
}

<div class="auth-card">
    <div class="auth-card-header">
        <div class="auth-logo">✉️</div>
        <h1 class="h4 fw-bold mb-1">Xác minh email</h1>
        <p class="text-muted small mb-0">Nhập mã OTP 6 chữ số đã gửi qua Gmail</p>
    </div>
    <div class="auth-card-body">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger py-2">@Model.ErrorMessage</div>
        }
        @if (!string.IsNullOrEmpty(Model.InfoMessage))
        {
            <div class="alert alert-info py-2">@Model.InfoMessage</div>
        }
        <form method="post">
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">Email</label>
                <div class="input-group">
                    <input asp-for="Input.Email" class="form-control bg-light" readonly autocomplete="username" aria-readonly="true" />
                    <span class="input-group-text bg-light" title="Email không thể thay đổi" aria-hidden="true">🔒</span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Otp" class="form-label">Mã OTP</label>
                <input asp-for="Input.Otp" class="form-control js-otp-input" inputmode="numeric" pattern="[0-9]*" maxlength="6" placeholder="000000" autocomplete="one-time-code" />
                <span asp-validation-for="Input.Otp" class="field-validation-error"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Xác minh</button>
        </form>
        <form method="post" asp-page-handler="Resend" class="mt-2">
            <input type="hidden" asp-for="Input.Email" />
            <button type="submit" class="btn btn-outline-secondary w-100">Gửi lại mã OTP</button>
        </form>
        <p class="text-center mt-3 mb-0 small">
            <a asp-page="/Account/Login">Quay lại đăng nhập</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.js-otp-input').forEach(function (input) {
            input.addEventListener('input', function () {
                this.value = this.value.replace(/\D/g, '').slice(0, 6);
            });
        });
    </script>
}
