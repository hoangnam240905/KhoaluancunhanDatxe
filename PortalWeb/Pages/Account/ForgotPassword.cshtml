@page
@model PortalWeb.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = "_LayoutAuth";
}

<div class="auth-card">
    <div class="auth-card-header">
        <div class="auth-logo">🔑</div>
        <h1 class="h4 fw-bold mb-1">Quên mật khẩu</h1>
        <p class="text-muted small mb-0">Nhập email để nhận mã OTP đặt lại mật khẩu</p>
    </div>
    <div class="auth-card-body">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger py-2">@Model.ErrorMessage</div>
        }
        @if (!string.IsNullOrEmpty(Model.InfoMessage))
        {
            <div class="alert alert-info py-2">@Model.InfoMessage</div>
        }
        <form method="post">
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">Email</label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" />
            </div>
            <button type="submit" class="btn btn-primary w-100">Gửi mã OTP</button>
        </form>
        <p class="text-center mt-3 mb-0 small">
            <a asp-page="/Account/Login">Quay lại đăng nhập</a>
        </p>
    </div>
</div>
