@page "/Customer/Bookings"
@model PortalWeb.Pages.Customer.Bookings.IndexModel
@{ ViewData["Title"] = "Đơn của tôi"; }

<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div>
        <h2>Đơn đặt xe của tôi</h2>
        <p>Xem hình thức thuê, tuyến đi và thông tin xe / tài xế</p>
    </div>
    <a asp-page="/Customer/Bookings/Create" class="btn btn-primary">+ Đặt xe mới</a>
</div>

@if (!Model.Bookings.Any())
{
    <div class="modern-card p-5 text-center text-muted">Bạn chưa có đơn đặt xe nào.</div>
}
else
{
    <div class="row g-3">
        @foreach (var b in Model.Bookings)
        {
            var selfDrive = IndexModel.IsSelfDrive(b.RentalMode);
            <div class="col-12">
                <div class="modern-card booking-detail-card p-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                        <div>
                            <div class="fw-bold fs-5">#@b.BookingId · @b.VehicleTypeName</div>
                            <div class="text-muted small">
                                Hình thức: <strong>@IndexModel.RentalModeLabel(b.RentalMode)</strong>
                                · Tạo lúc @b.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>
                        <span class="badge bg-secondary badge-status">@b.Status</span>
                    </div>
                    <div class="mb-3">
                        <a asp-page="Details" asp-route-id="@b.BookingId" class="btn btn-sm btn-outline-primary">Chi tiết</a>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="detail-label">Điểm đón</div>
                            <div class="fw-semibold">@b.PickupAddress</div>
                        </div>
                        <div class="col-md-6">
                            <div class="detail-label">Điểm trả</div>
                            <div class="fw-semibold">@b.DropoffAddress</div>
                        </div>
                        <div class="col-md-3">
                            <div class="detail-label">Thời gian</div>
                            <div>@b.StartDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                            <div class="small text-muted">đến @b.EndDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                        <div class="col-md-3">
                            <div class="detail-label">Cước phí</div>
                            <div class="fw-bold text-primary">@b.TotalAmount.ToString("N0") VND</div>
                            @if (b.FinalAmount is not null)
                            {
                                <div class="small text-muted">Giá chốt: @b.FinalAmount.Value.ToString("N0") VND</div>
                            }
                            @if (b.EstimatedDistance is not null)
                            {
                                <div class="small text-muted">~@b.EstimatedDistance km</div>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(b.Notes))
                    {
                        <div class="mt-3">
                            <div class="detail-label">Ghi chú</div>
                            <div>@b.Notes</div>
                        </div>
                    }

                    <div class="driver-box mt-4">
                        @if (selfDrive)
                        {
                            @if (b.AssignedVehicle is null)
                            {
                                <div class="text-muted">Xe: chờ điều phối gán xe.</div>
                            }
                            else
                            {
                                <div class="row g-2">
                                    <div class="col-md-4">
                                        <div class="detail-label">Xe đã gán</div>
                                        <div class="fw-bold">@b.AssignedVehicle.LicensePlate</div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="detail-label">Mẫu xe</div>
                                        <div>@b.AssignedVehicle.Brand @b.AssignedVehicle.Model</div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="detail-label">Trạng thái xe</div>
                                        <span class="badge bg-info text-dark">@b.AssignedVehicle.Status</span>
                                    </div>
                                </div>
                            }
                        }
                        else if (b.Assignment is null)
                        {
                            <div class="text-muted">
                                <strong>Tài xế:</strong> Chưa phân công — đợi điều phối xác nhận.
                            </div>
                        }
                        else
                        {
                            <div class="row g-2 align-items-center">
                                <div class="col-md-4">
                                    <div class="detail-label">Tài xế</div>
                                    <div class="fw-bold">@b.Assignment.DriverName</div>
                                </div>
                                <div class="col-md-3">
                                    <div class="detail-label">Số điện thoại</div>
                                    <div>@(string.IsNullOrWhiteSpace(b.Assignment.DriverPhone) ? "—" : b.Assignment.DriverPhone)</div>
                                </div>
                                <div class="col-md-3">
                                    <div class="detail-label">Biển số xe</div>
                                    <div class="fw-semibold">@b.Assignment.LicensePlate</div>
                                </div>
                                <div class="col-md-2">
                                    <div class="detail-label">TT phân công</div>
                                    <span class="badge bg-info text-dark">@b.Assignment.Status</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
