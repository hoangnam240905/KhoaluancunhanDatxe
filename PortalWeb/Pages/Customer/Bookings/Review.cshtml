@page "/Customer/Bookings/Review/{id:int}"
@model PortalWeb.Pages.Customer.Bookings.ReviewModel
@{
    ViewData["Title"] = "Chia sẻ trải nghiệm của bạn";
    ViewData["FullBleed"] = true;
    ViewData["HomeShell"] = true;
    var p = Model.Presentation;
    var existingRating = p.ExistingRating ?? 0;
    var initials = string.IsNullOrWhiteSpace(Model.UserName)
        ? "DX"
        : string.Concat(Model.UserName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0])).ToUpperInvariant();
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/review.css" asp-append-version="true" />
}

<div class="ch-page" data-rv-page data-rv-view="@Model.ViewState">
    <header class="ch-nav">
        <div class="ch-container ch-nav-inner">
            <a class="ch-brand" href="/">
                <span class="ch-brand-mark"><i class="bi bi-car-front-fill"></i></span>
                DriveX
            </a>
            <nav class="ch-nav-links" aria-label="Khách hàng">
                <a href="/">Trang chủ</a>
                <a asp-page="/Search">Xe</a>
                <a class="is-active" asp-page="/Customer/Bookings/Index">Đơn đặt</a>
                <a href="/#about">Về chúng tôi</a>
            </nav>
            <div class="ch-nav-actions">
                <a class="ch-icon-btn" asp-page="/Search" title="Tìm xe" aria-label="Tìm xe"><i class="bi bi-search"></i></a>
                <partial name="_CustomerNotify" />
                <button type="button" class="ch-nav-toggle" data-bs-toggle="collapse" data-bs-target="#chMobileNav" aria-label="Mở menu">
                    <i class="bi bi-list"></i>
                </button>
                <div class="dropdown">
                    <a class="dx-user" href="#" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="dx-avatar">@initials</span>
                        <span class="dx-user-meta ch-user-meta">
                            <span class="dx-user-name">@Model.UserName</span>
                            <span class="dx-user-role">Khách hàng</span>
                        </span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" asp-page="/Customer/Profile">Hồ sơ cá nhân</a></li>
                        <li><a class="dropdown-item" asp-page="/Account/ChangePassword">Đổi mật khẩu</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item" asp-page="/Account/Logout">Đăng xuất</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="ch-container">
            <div class="collapse ch-nav-mobile" id="chMobileNav">
                <a href="/">Trang chủ</a>
                <a asp-page="/Search">Xe</a>
                <a asp-page="/Customer/Bookings/Index">Đơn đặt</a>
                <a href="/#about">Về chúng tôi</a>
            </div>
        </div>
    </header>

    <section class="rv-head">
        <div class="ch-container">
            <div class="ch-eyebrow">Đánh giá</div>
            <h1>Chia sẻ trải nghiệm của bạn</h1>
            <p>Đánh giá chuyến thuê để giúp chúng tôi mang đến trải nghiệm tốt hơn.</p>
            <a class="rv-back" asp-page="Details" asp-route-id="@Model.BookingRouteId"><i class="bi bi-arrow-left"></i> Quay lại chi tiết đơn</a>
        </div>
    </section>

    <section class="rv-body">
        <div class="ch-container">
            <form method="post" class="rv-form" data-rv-form data-rv-form-el>
                <input type="hidden" asp-for="Input.Rating" data-rv-rating-input />
                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage) && Model.ViewState == "form")
                {
                    <div class="rv-error is-on" style="display:block;margin-bottom:0.85rem">@Model.ErrorMessage</div>
                }
                <div class="rv-layout">
                    <div>
                        <article class="rv-card rv-trip">
                            <img src="@p.ImageUrl" alt="@p.Title" />
                            <div>
                                <h3>@p.Title</h3>
                                @if (!string.IsNullOrWhiteSpace(p.Meta))
                                {
                                    <div class="rv-meta">@p.Meta</div>
                                }
                                <div class="rv-code">Mã đơn @p.Code</div>
                                @if (!string.IsNullOrWhiteSpace(p.RentalModeLabel))
                                {
                                    <div class="rv-when">@p.RentalModeLabel</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(p.DriverName))
                                {
                                    <div class="rv-when">Tài xế: @p.DriverName</div>
                                }
                                @if (p.PickupAt != default && p.ReturnAt != default)
                                {
                                    <div class="rv-when">@ReviewUi.When(p.PickupAt) → @ReviewUi.When(p.ReturnAt)</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(p.StatusLabel))
                                {
                                    <span class="rv-badge">@p.StatusLabel</span>
                                }
                            </div>
                        </article>

                        <article class="rv-card">
                            <h2>Bạn đánh giá chuyến thuê này thế nào?</h2>
                            <div class="rv-stars" data-rv-stars>
                                @for (var i = 1; i <= 5; i++)
                                {
                                    <button type="button" class="rv-star" data-rv-star="@i" aria-label="@i sao"><i class="bi bi-star-fill"></i></button>
                                }
                            </div>
                            <div class="rv-score" data-rv-score>Chưa chọn số sao</div>
                        </article>

                        <article class="rv-card">
                            <h2>Nhận xét của bạn</h2>
                            <p class="rv-hint" data-rv-hint>Chọn số sao để tiếp tục.</p>
                            <textarea class="rv-textarea" asp-for="Input.Comment" data-rv-comment maxlength="500" rows="5" placeholder="Hãy chia sẻ trải nghiệm của bạn về chuyến thuê..."></textarea>
                            <div class="rv-count" data-rv-count>0 / 500</div>
                            <div class="rv-error" data-rv-error></div>
                        </article>

                        <article class="rv-card">
                            <h2>Để lại đánh giá hữu ích</h2>
                            <ul class="rv-guide">
                                <li>Chia sẻ trải nghiệm thực tế của bạn.</li>
                                <li>Tập trung vào chất lượng chuyến thuê.</li>
                                <li>Giữ nội dung lịch sự và rõ ràng.</li>
                            </ul>
                        </article>

                        <div class="rv-submit-mobile">
                            <button type="submit" class="rv-btn" data-rv-submit><span data-rv-submit-label>Gửi đánh giá</span></button>
                        </div>
                    </div>

                    <aside class="rv-side">
                        <article class="rv-card">
                            <h2>Tóm tắt đánh giá</h2>
                            <div class="rv-preview">
                                <small class="rv-meta">Số sao</small>
                                <strong data-rv-preview-score>—</strong>
                                <p class="rv-help" data-rv-preview-label>Chưa chọn số sao</p>
                            </div>
                            <p class="rv-help">1–3 sao cần nhận xét. 4–5 sao có thể bỏ trống.</p>
                            <div class="rv-submit-desktop" style="margin-top:1rem">
                                <button type="submit" class="rv-btn" data-rv-submit><span data-rv-submit-label>Gửi đánh giá</span></button>
                            </div>
                        </article>
                        <article class="rv-card">
                            <h2>Thông tin hữu ích</h2>
                            <p class="rv-help">Đánh giá giúp DriveX cải thiện chất lượng chuyến thuê cho hành trình tiếp theo.</p>
                        </article>
                    </aside>
                </div>
            </form>

            <div class="rv-state rv-card rv-center" data-rv-state="processing">
                <div class="rv-spin" aria-hidden="true"></div>
                <h2>Đang gửi đánh giá...</h2>
                <p>Đánh giá của bạn đang được xử lý.</p>
            </div>

            <div class="rv-state rv-card rv-center" data-rv-state="success">
                <i class="bi bi-check-circle-fill"></i>
                <h2>Cảm ơn bạn đã đánh giá!</h2>
                <p>Đánh giá của bạn đã được ghi nhận.</p>
                <img src="@p.ImageUrl" alt="@p.Title" />
                <h3>@p.Title</h3>
                <div class="rv-stars-static">@ReviewUi.Stars(existingRating)</div>
                <div class="rv-score"><span data-rv-success-score>@(existingRating > 0 ? $"{existingRating} / 5" : "")</span></div>
                <p data-rv-success-label>@(existingRating > 0 ? ReviewUi.RatingLabel(existingRating) : "")</p>
                @if (!string.IsNullOrWhiteSpace(p.ExistingComment))
                {
                    <p>“@p.ExistingComment”</p>
                }
                @if (p.ExistingCreatedAt is DateTime successAt)
                {
                    <p class="rv-help">@ReviewUi.When(successAt)</p>
                }
                <a class="rv-btn" asp-page="Details" asp-route-id="@Model.BookingRouteId">Xem chi tiết đơn</a>
                <a class="rv-btn-ghost" asp-page="Index">Về danh sách đơn</a>
            </div>

            <div class="rv-state rv-card rv-center" data-rv-state="existing">
                <i class="bi bi-star-fill"></i>
                <h2>Bạn đã đánh giá chuyến thuê này</h2>
                <img src="@p.ImageUrl" alt="@p.Title" />
                <h3>@p.Title</h3>
                <div class="rv-stars-static">@ReviewUi.Stars(existingRating)</div>
                <div class="rv-score"><span>@(existingRating > 0 ? $"{existingRating} / 5" : "")</span></div>
                @if (existingRating > 0)
                {
                    <p>@ReviewUi.RatingLabel(existingRating)</p>
                }
                @if (!string.IsNullOrWhiteSpace(p.ExistingComment))
                {
                    <p>“@p.ExistingComment”</p>
                }
                @if (p.ExistingCreatedAt is DateTime existingAt)
                {
                    <p class="rv-help">@ReviewUi.When(existingAt)</p>
                }
                <span class="rv-badge">Đã đánh giá</span>
                <a class="rv-btn" asp-page="Details" asp-route-id="@Model.BookingRouteId" style="margin-top:1rem">Quay lại chi tiết đơn</a>
            </div>

            <div class="rv-state rv-card rv-center" data-rv-state="unavailable">
                <i class="bi bi-clock-history"></i>
                <h2>Chưa thể đánh giá</h2>
                <p>@(string.IsNullOrWhiteSpace(Model.ErrorMessage) ? ReviewUi.Unavailable : Model.ErrorMessage)</p>
                <a class="rv-btn" asp-page="Details" asp-route-id="@Model.BookingRouteId">Quay lại đơn thuê</a>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/review.js" asp-append-version="true"></script>
}
