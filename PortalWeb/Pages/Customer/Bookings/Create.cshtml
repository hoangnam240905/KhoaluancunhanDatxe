@page "/Customer/Bookings/Create"
@model PortalWeb.Pages.Customer.Bookings.CreateModel
@{ ViewData["Title"] = "Đặt xe"; }

<div class="page-header">
    <h2>Đặt xe</h2>
    <p>Chọn hình thức thuê, loại xe và thông tin chuyến đi</p>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
@if (!string.IsNullOrEmpty(Model.InfoMessage))
{
    <div class="alert alert-info">@Model.InfoMessage</div>
}
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="modern-card p-4 col-lg-9">
    <form method="post" class="row g-4">
        <div class="col-12">
            <div class="fw-semibold mb-2">Hình thức thuê</div>
            <div class="row g-3">
                <div class="col-md-6">
                    <input class="btn-check" type="radio" asp-for="Input.RentalMode" value="WithDriver" id="rentalWithDriver" />
                    <label class="btn btn-outline-primary w-100 text-start p-3 h-100" for="rentalWithDriver">
                        <div class="fw-bold">Có tài xế</div>
                        <div class="small fw-normal text-muted mt-1">Thuê xe kèm tài xế. Tài xế sẽ được hệ thống điều phối và phân công cho chuyến.</div>
                    </label>
                </div>
                <div class="col-md-6">
                    <input class="btn-check" type="radio" asp-for="Input.RentalMode" value="SelfDrive" id="rentalSelfDrive" />
                    <label class="btn btn-outline-primary w-100 text-start p-3 h-100" for="rentalSelfDrive">
                        <div class="fw-bold">Tự lái</div>
                        <div class="small fw-normal text-muted mt-1">Tự lái xe. Khách nhận xe và tự sử dụng trong thời gian thuê.</div>
                    </label>
                </div>
            </div>
            <span asp-validation-for="Input.RentalMode" class="text-danger"></span>
        </div>

        <div class="col-12">
            <div class="fw-semibold mb-2">Loại xe</div>
            @if (!Model.VehicleTypes.Any())
            {
                <p class="text-muted mb-0">Chưa có loại xe khả dụng.</p>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var t in Model.VehicleTypes)
                    {
                        <div class="col-md-6">
                            <input class="btn-check" type="radio" asp-for="Input.VehicleTypeId" value="@t.TypeId" id="vt-@t.TypeId" />
                            <label class="btn btn-outline-secondary w-100 text-start p-3 h-100" for="vt-@t.TypeId">
                                @if (!string.IsNullOrWhiteSpace(t.ImageUrl))
                                {
                                    <img src="@t.ImageUrl" alt="@t.TypeName" class="img-fluid rounded mb-2" style="max-height:120px;object-fit:cover;width:100%;" />
                                }
                                <div class="fw-bold">@t.TypeName</div>
                                <div class="small text-muted">@t.SeatCapacity chỗ</div>
                                <div class="small mt-1">Catalog: @t.PricePerDay.ToString("N0") VND/ngày · @t.PricePerKm.ToString("N0") VND/km</div>
                                <div class="small text-muted">Giá đặt lấy từ báo giá máy chủ.</div>
                            </label>
                        </div>
                    }
                </div>
            }
            <span asp-validation-for="Input.VehicleTypeId" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Input.StartDate" class="form-label">Bắt đầu</label>
            <input asp-for="Input.StartDate" class="form-control" type="datetime-local" value="@Model.Input.StartDate.ToString("yyyy-MM-ddTHH:mm")" />
            <span asp-validation-for="Input.StartDate" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.EndDate" class="form-label">Kết thúc</label>
            <input asp-for="Input.EndDate" class="form-control" type="datetime-local" value="@Model.Input.EndDate.ToString("yyyy-MM-ddTHH:mm")" />
            <span asp-validation-for="Input.EndDate" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.PickupAddress" class="form-label">Điểm đón</label>
            <input asp-for="Input.PickupAddress" class="form-control" placeholder="TP.HCM" />
            <span asp-validation-for="Input.PickupAddress" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.DropoffAddress" class="form-label">Điểm trả</label>
            <input asp-for="Input.DropoffAddress" class="form-control" placeholder="Vũng Tàu" />
            <span asp-validation-for="Input.DropoffAddress" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.EstimatedDistance" class="form-label">Km ước tính (không bắt buộc)</label>
            <input asp-for="Input.EstimatedDistance" class="form-control" type="number" step="0.1" min="0" />
        </div>
        <div class="col-12">
            <label asp-for="Input.Notes" class="form-label">Ghi chú</label>
            <textarea asp-for="Input.Notes" class="form-control" rows="2" placeholder="Yêu cầu đặc biệt, hành lý, điểm đón..."></textarea>
        </div>
        <input type="hidden" asp-for="QuoteConfirmed" />
        <input type="hidden" asp-for="QuotedFingerprint" />

        @if (Model.Quote is not null)
        {
            var q = Model.Quote;
            var selfDrive = CreateModel.IsSelfDrive(q.RentalMode);
            <div class="col-12">
                <div class="driver-box">
                    <div class="fw-bold mb-2">Báo giá từ máy chủ</div>
                    <div class="small text-muted mb-3">Giá lấy từ GET /api/bookings/quote. Trang không tự tính tổng.</div>
                    <div class="row g-2">
                        <div class="col-md-4"><div class="detail-label">Hình thức</div><div>@(selfDrive ? "Tự lái" : "Có tài xế")</div></div>
                        <div class="col-md-4"><div class="detail-label">Giá thuê/ngày</div><div>@q.QuotedPricePerDay.ToString("N0") VND</div></div>
                        <div class="col-md-4"><div class="detail-label">Số ngày</div><div>@q.QuotedDays</div></div>
                        @if (selfDrive)
                        {
                            <div class="col-md-4"><div class="detail-label">Km miễn phí</div><div>@q.IncludedKm.ToString("N0") km</div></div>
                            <div class="col-md-4"><div class="detail-label">Km vượt ước tính</div><div>@q.ExtraKm.ToString("N0") km</div></div>
                            <div class="col-md-4"><div class="detail-label">Phí km vượt</div><div>@q.ExtraKmPrice.ToString("N0") VND</div></div>
                        }
                        else
                        {
                            <div class="col-md-4"><div class="detail-label">Phí tài xế</div><div>@q.DriverAmount.ToString("N0") VND</div></div>
                            <div class="col-md-4"><div class="detail-label">Km dự kiến</div><div>@q.EstimatedDistance.ToString("N0") km</div></div>
                            <div class="col-md-4"><div class="detail-label">Cước km</div><div>@q.DistanceAmount.ToString("N0") VND</div></div>
                        }
                        <div class="col-md-4"><div class="detail-label">Tạm tính</div><div class="fw-bold text-primary">@q.TotalAmount.ToString("N0") VND</div></div>
                        <div class="col-md-4"><div class="detail-label">Cọc dự kiến</div><div>@q.DepositAmount.ToString("N0") VND</div></div>
                    </div>
                </div>
            </div>
        }

        <div class="col-12">
            <button type="submit" asp-page-handler="Quote" class="btn btn-outline-primary px-4">Xem báo giá</button>
            <button type="submit" class="btn btn-primary px-4">Gửi yêu cầu đặt xe</button>
            <a asp-page="/Customer/Bookings/Index" class="btn btn-outline-secondary ms-2">Quay lại</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
