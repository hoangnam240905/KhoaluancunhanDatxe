@page "/Admin/Bookings"
@model PortalWeb.Pages.AdminUi.BookingsModel
@{
    Layout = "_AdminUiLayout";
    ViewData["Title"] = "Quản lý đơn thuê";
    ViewData["Nav"] = "bookings";
    ViewData["SearchPlaceholder"] = "Tìm mã đơn, khách hàng hoặc xe";
}
<div id="auiBookings" data-aui-bookings="1">
    <form id="auiBookingsAntiForgery" style="display:none" method="post">@Html.AntiForgeryToken()</form>
    <script type="application/json" id="auiBookingsPayload">@Html.Raw(Model.BookingsJson)</script>

    <div class="aui-page-head">
        <div>
            <h1>Quản lý đơn thuê</h1>
            <p>Xem và quản lý toàn bộ đơn thuê xe trên hệ thống.</p>
        </div>
        <div class="aui-head-actions">
            <button type="button" class="aui-btn aui-btn-primary" data-new-booking><i class="bi bi-plus-lg"></i> Tạo đơn thuê</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="aui-empty" role="alert" data-bookings-error>
            <i class="bi bi-exclamation-triangle"></i>
            <p>@Model.ErrorMessage</p>
        </div>
    }

    <div class="aui-kpi-grid cols-5" data-bookings-kpis @(string.IsNullOrEmpty(Model.ErrorMessage) ? null : "hidden")>
        <div class="aui-card aui-kpi">
            <div class="aui-kpi-icon blue"><i class="bi bi-collection"></i></div>
            <div>
                <div class="aui-kpi-label">Tổng đơn thuê</div>
                <div class="aui-kpi-value" data-kpi="total">—</div>
            </div>
        </div>
        <div class="aui-card aui-kpi">
            <div class="aui-kpi-icon amber"><i class="bi bi-hourglass-split"></i></div>
            <div>
                <div class="aui-kpi-label">Chờ xác nhận</div>
                <div class="aui-kpi-value" data-kpi="pending">—</div>
            </div>
        </div>
        <div class="aui-card aui-kpi">
            <div class="aui-kpi-icon purple"><i class="bi bi-arrow-repeat"></i></div>
            <div>
                <div class="aui-kpi-label">Đang thực hiện</div>
                <div class="aui-kpi-value" data-kpi="inProgress">—</div>
            </div>
        </div>
        <div class="aui-card aui-kpi">
            <div class="aui-kpi-icon green"><i class="bi bi-check2-circle"></i></div>
            <div>
                <div class="aui-kpi-label">Hoàn thành</div>
                <div class="aui-kpi-value" data-kpi="completed">—</div>
            </div>
        </div>
        <div class="aui-card aui-kpi">
            <div class="aui-kpi-icon red"><i class="bi bi-x-circle"></i></div>
            <div>
                <div class="aui-kpi-label">Đã hủy</div>
                <div class="aui-kpi-value" data-kpi="cancelled">—</div>
            </div>
        </div>
    </div>

    <div class="aui-filters" @(string.IsNullOrEmpty(Model.ErrorMessage) ? null : "hidden")>
        <div class="aui-field grow">
            <label>Tìm kiếm</label>
            <input class="aui-input" placeholder="Tìm mã đơn, khách hàng hoặc xe" data-filter-q />
        </div>
        <div class="aui-field">
            <label>Trạng thái</label>
            <select class="aui-select" data-filter-status>
                <option value="">Tất cả trạng thái</option>
                <option value="Pending">Chờ xác nhận</option>
                <option value="Confirmed">Đã xác nhận</option>
                <option value="Assigned">Đã phân công</option>
                <option value="InProgress">Đang thực hiện</option>
                <option value="Completed">Hoàn thành</option>
                <option value="Cancelled">Đã hủy</option>
            </select>
        </div>
        <div class="aui-field">
            <label>Hình thức thuê</label>
            <select class="aui-select" data-filter-rental>
                <option value="">Tất cả hình thức thuê</option>
                <option value="SelfDrive">Tự lái</option>
                <option value="WithDriver">Có tài xế</option>
            </select>
        </div>
        <div class="aui-field">
            <label>Khoảng thời gian</label>
            <div class="aui-daterange" data-daterange data-daterange-mode="filter">
                <button type="button" class="aui-btn aui-btn-ghost aui-daterange-trigger" data-daterange-toggle aria-haspopup="dialog">
                    <i class="bi bi-calendar3"></i>
                    <span data-daterange-label>Tất cả thời gian</span>
                </button>
                <div class="aui-daterange-panel" data-daterange-panel hidden>
                    <div class="aui-field">
                        <label>Từ ngày</label>
                        <input class="aui-input" type="date" data-daterange-from />
                    </div>
                    <div class="aui-field">
                        <label>Đến ngày</label>
                        <input class="aui-input" type="date" data-daterange-to />
                    </div>
                    <div class="aui-daterange-actions">
                        <button type="button" class="aui-btn aui-btn-ghost" data-daterange-cancel>Hủy</button>
                        <button type="button" class="aui-btn aui-btn-primary" data-daterange-apply>Áp dụng</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="aui-field" style="align-self:end">
            <button type="button" class="aui-btn aui-btn-ghost" data-export><i class="bi bi-download"></i> Xuất dữ liệu</button>
        </div>
    </div>

    <div class="aui-card" @(string.IsNullOrEmpty(Model.ErrorMessage) ? null : "hidden")>
        <div class="aui-table-wrap">
            <table class="aui-table">
                <thead>
                    <tr>
                        <th><input type="checkbox" data-select-all /></th>
                        <th>#</th>
                        <th>Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Mẫu xe</th>
                        <th>Hình thức thuê</th>
                        <th>Thời gian thuê</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody data-table-body>
                    <tr><td colspan="10"><div class="aui-empty"><i class="bi bi-arrow-repeat"></i>Đang tải dữ liệu...</div></td></tr>
                </tbody>
            </table>
        </div>
        <div class="aui-pager" data-pager></div>
    </div>
</div>
