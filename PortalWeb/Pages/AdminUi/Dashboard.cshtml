@page "/Admin"
@model PortalWeb.Pages.AdminUi.DashboardModel
@using PortalWeb.Display
@{
    Layout = "_AdminUiLayout";
    ViewData["Title"] = "Tổng quan";
    ViewData["Nav"] = "dashboard";
    ViewData["SearchPlaceholder"] = "Tìm đơn thuê, xe, khách hàng...";
    var d = Model.Dashboard;
    string BadgeClass(string? status) => status switch
    {
        "Pending" => "amber",
        "Confirmed" => "green",
        "Assigned" => "blue",
        "InProgress" => "blue",
        "Completed" => "green",
        "Cancelled" => "red",
        _ => "slate"
    };
    string ChangeHtml(decimal? pct)
    {
        if (pct is null)
            return "<div class=\"aui-kpi-change\"><span>so với kỳ trước</span></div>";
        var tone = pct >= 0 ? "up" : "down";
        var sign = pct >= 0 ? "+" : "";
        return $"<div class=\"aui-kpi-change {tone}\">{sign}{pct:0.#}% <span>so với kỳ trước</span></div>";
    }
}
<div id="auiDashboard" data-aui-dashboard="1">
    <script type="application/json" id="auiDashChartPayload">@Html.Raw(Model.ChartPayloadJson)</script>
    <div class="aui-page-head">
        <div>
            <h1>Chào mừng trở lại, @Model.WelcomeName!</h1>
            <p>Đây là tình hình hoạt động kinh doanh cho thuê xe của bạn hôm nay.</p>
        </div>
        <div class="aui-head-actions">
            @{
                var rangeFrom = d?.Range.From.Date ?? DateTime.Today.AddDays(-30);
                var rangeTo = d?.Range.To.Date ?? DateTime.Today;
                var vi = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
            }
            <div class="aui-daterange" data-daterange data-daterange-mode="navigate" data-daterange-base="/Admin">
                <button type="button" class="aui-btn aui-btn-ghost" data-daterange-toggle aria-haspopup="dialog">
                    <i class="bi bi-calendar3"></i>
                    <span data-daterange-label>@rangeFrom.ToString("dd/MM/yyyy", vi) - @rangeTo.ToString("dd/MM/yyyy", vi)</span>
                </button>
                <div class="aui-daterange-panel" data-daterange-panel hidden>
                    <div class="aui-field">
                        <label>Từ ngày</label>
                        <input class="aui-input" type="date" data-daterange-from value="@rangeFrom.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="aui-field">
                        <label>Đến ngày</label>
                        <input class="aui-input" type="date" data-daterange-to value="@rangeTo.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="aui-daterange-actions">
                        <button type="button" class="aui-btn aui-btn-ghost" data-daterange-cancel>Hủy</button>
                        <button type="button" class="aui-btn aui-btn-primary" data-daterange-apply>Áp dụng</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="aui-empty" role="alert">
            <i class="bi bi-exclamation-triangle"></i>
            <p>@Model.ErrorMessage</p>
        </div>
    }
    else if (d is null)
    {
        <div class="aui-empty" id="auiDashLoading">
            <i class="bi bi-arrow-repeat"></i>
            <p>Đang tải dữ liệu...</p>
        </div>
    }
    else
    {
        <div class="aui-kpi-grid">
            <div class="aui-card aui-kpi">
                <div class="aui-kpi-icon blue"><i class="bi bi-cash-stack"></i></div>
                <div>
                    <div class="aui-kpi-label">Tổng doanh thu</div>
                    <div class="aui-kpi-value">@BookingDetailUi.Money(d.Summary.DepositPaidAmount)</div>
                    @Html.Raw(ChangeHtml(d.Summary.DepositPaidChangePercent))
                </div>
            </div>
            <div class="aui-card aui-kpi">
                <div class="aui-kpi-icon green"><i class="bi bi-calendar2-check"></i></div>
                <div>
                    <div class="aui-kpi-label">Tổng đơn thuê</div>
                    <div class="aui-kpi-value">@d.Summary.TotalBookings.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))</div>
                    @Html.Raw(ChangeHtml(d.Summary.BookingsChangePercent))
                </div>
            </div>
            <div class="aui-card aui-kpi">
                <div class="aui-kpi-icon purple"><i class="bi bi-truck-front"></i></div>
                <div>
                    <div class="aui-kpi-label">Đội xe đang hoạt động</div>
                    <div class="aui-kpi-value">@d.ActiveFleet.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))</div>
                    <div class="aui-kpi-change"><span>snapshot hiện tại</span></div>
                </div>
            </div>
            <div class="aui-card aui-kpi">
                <div class="aui-kpi-icon amber"><i class="bi bi-people"></i></div>
                <div>
                    <div class="aui-kpi-label">Tổng khách hàng</div>
                    <div class="aui-kpi-value">@d.TotalCustomers.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))</div>
                    <div class="aui-kpi-change"><span>snapshot hiện tại</span></div>
                </div>
            </div>
        </div>

        <div class="aui-grid-2">
            <div class="aui-card aui-card-pad">
                <div class="aui-card-head">
                    <div>
                        <h3 class="aui-card-title">Tổng quan doanh thu</h3>
                        <p class="aui-card-sub">Doanh thu theo tháng trong 12 tháng gần nhất</p>
                    </div>
                </div>
                @{
                    var revenueEmpty = (d.RevenueOverview?.Count ?? 0) == 0
                        || d.RevenueOverview!.All(x => x.Amount == 0);
                }
                @if (revenueEmpty)
                {
                    <div class="aui-empty"><p>Chưa có dữ liệu.</p></div>
                }
                else
                {
                    <div class="aui-chart-box"><canvas id="chartRevenue"></canvas></div>
                }
            </div>
            <div class="aui-card aui-card-pad">
                <div class="aui-card-head">
                    <div>
                        <h3 class="aui-card-title">Xe được thuê nhiều nhất</h3>
                        <p class="aui-card-sub">Các mẫu xe được đặt nhiều nhất trong kỳ</p>
                    </div>
                </div>
                @if (d.TopVehicles.Count == 0)
                {
                    <div class="aui-empty"><p>Chưa có dữ liệu.</p></div>
                }
                else
                {
                    <div id="topVehicles"></div>
                }
            </div>
        </div>

        <div class="aui-grid-2 equal">
            <div class="aui-card aui-card-pad">
                <div class="aui-card-head">
                    <div>
                        <h3 class="aui-card-title">Trạng thái đơn thuê</h3>
                        <p class="aui-card-sub">Phân bổ theo pipeline đang hoạt động</p>
                    </div>
                </div>
                @if (d.Bookings.Total == 0)
                {
                    <div class="aui-empty"><p>Chưa có dữ liệu.</p></div>
                }
                else
                {
                    <div class="aui-donut-wrap">
                        <canvas id="chartBookingStatus"></canvas>
                        <div class="aui-donut-center" id="donutCenter"></div>
                    </div>
                    <div class="aui-legend">
                        <span class="aui-legend-item"><span class="aui-legend-dot" style="background:#16A34A"></span>Đã xác nhận</span>
                        <span class="aui-legend-item"><span class="aui-legend-dot" style="background:#D97706"></span>Chờ xác nhận</span>
                        <span class="aui-legend-item"><span class="aui-legend-dot" style="background:#2563EB"></span>Đang thực hiện</span>
                        <span class="aui-legend-item"><span class="aui-legend-dot" style="background:#DC2626"></span>Đã hủy</span>
                    </div>
                }
            </div>
            <div class="aui-card aui-card-pad">
                <div class="aui-card-head">
                    <div>
                        <h3 class="aui-card-title">Lịch nhận xe sắp tới</h3>
                        <p class="aui-card-sub">Các lịch bàn giao sắp diễn ra</p>
                    </div>
                </div>
                @if ((d.UpcomingPickups?.Count ?? 0) == 0)
                {
                    <div class="aui-empty"><p>Chưa có dữ liệu.</p></div>
                }
                else
                {
                    <div class="aui-table-wrap">
                        <table class="aui-table" style="min-width:520px">
                            <thead>
                                <tr>
                                    <th>Khách hàng</th>
                                    <th>Xe</th>
                                    <th>Ngày &amp; giờ</th>
                                    <th>Trạng thái</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var row in d.UpcomingPickups!)
                            {
                                <tr>
                                    <td>@row.CustomerName</td>
                                    <td>@row.VehicleLabel</td>
                                    <td>@BookingDetailUi.When(row.StartDate)</td>
                                    <td><span class="aui-badge @BadgeClass(row.Status)">@UiDisplay.BookingStatus(row.Status)</span></td>
                                    <td><a class="aui-btn aui-btn-sm aui-btn-ghost" asp-page="/AdminUi/Bookings">Xem</a></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="aui-card">
            <div class="aui-card-pad" style="padding-bottom:.35rem">
                <h3 class="aui-card-title">Đơn thuê gần đây</h3>
                <p class="aui-card-sub">Hoạt động mới nhất trên hệ thống</p>
            </div>
            @if ((d.RecentBookings?.Count ?? 0) == 0)
            {
                <div class="aui-empty"><p>Chưa có dữ liệu.</p></div>
            }
            else
            {
                <div class="aui-table-wrap">
                    <table class="aui-table">
                        <thead>
                            <tr>
                                <th>Mã đơn</th>
                                <th>Khách hàng</th>
                                <th>Xe</th>
                                <th>Ngày nhận xe</th>
                                <th>Trạng thái</th>
                                <th>Số tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in d.RecentBookings!)
                        {
                            <tr>
                                <td><strong>#@row.BookingId</strong></td>
                                <td>@row.CustomerName</td>
                                <td>@row.VehicleLabel</td>
                                <td>@BookingDetailUi.Day(row.StartDate)</td>
                                <td><span class="aui-badge @BadgeClass(row.Status)">@UiDisplay.BookingStatus(row.Status)</span></td>
                                <td>@BookingDetailUi.Money(row.TotalAmount)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>
