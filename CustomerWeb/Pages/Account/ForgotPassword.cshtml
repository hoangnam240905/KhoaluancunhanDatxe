@page
@model CustomerWeb.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Quen mat khau";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="mb-4">Quen mat khau</h2>
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }
                <form method="post">
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Email</label>
                        <input asp-for="Input.Email" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Gui ma OTP</button>
                </form>
                <p class="mt-3 mb-0 text-center">
                    <a href="http://localhost:5180/Account/Login">Dang nhap</a>
                </p>
            </div>
        </div>
    </div>
</div>
