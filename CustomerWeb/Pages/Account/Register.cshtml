@page
@model CustomerWeb.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Dang ky";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="mb-4">Dang ky tai khoan</h2>
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }
                <form method="post">
                    <div class="mb-3">
                        <label asp-for="Input.FullName" class="form-label">Họ và tên</label>
                        <input asp-for="Input.FullName" class="form-control" placeholder="Nguyễn Văn A" />
                        <span asp-validation-for="Input.FullName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Gmail</label>
                        <input asp-for="Input.Email" class="form-control" placeholder="abc@gmail.com" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label">Mật khẩu</label>
                        <input asp-for="Input.Password" class="form-control" type="password" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.ConfirmPassword" class="form-label">Xac nhan mat khau</label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" type="password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Phone" class="form-label">Số điện thoại</label>
                        <input asp-for="Input.Phone" class="form-control" placeholder="09xxxxxxxx" />
                        <span asp-validation-for="Input.Phone" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Address" class="form-label">Dia chi</label>
                        <input asp-for="Input.Address" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Dang ky</button>
                </form>
                @if (Model.GoogleEnabled)
                {
                    <div class="text-center my-3 text-muted small">hoac</div>
                    <div class="d-flex justify-content-center">
                        <div id="g_id_onload"
                             data-client_id="@Model.GoogleClientId"
                             data-callback="handleGoogleCredential"
                             data-auto_prompt="false"></div>
                        <div class="g_id_signin" data-type="standard" data-size="large" data-theme="outline" data-text="continue_with"></div>
                    </div>
                    <form id="google-form" method="post" asp-page-handler="Google" class="d-none">
                        <input type="hidden" asp-for="GoogleIdToken" id="google-id-token" />
                    </form>
                }
                <p class="mt-3 mb-0 text-center">
                    Da co tai khoan? <a href="http://localhost:5180/Account/Login">Dang nhap</a>
                    · <a asp-page="/Account/ForgotPassword">Quen mat khau</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.GoogleEnabled)
    {
        <script src="https://accounts.google.com/gsi/client" async defer></script>
        <script>
            function handleGoogleCredential(response) {
                if (!response || !response.credential) return;
                document.getElementById('google-id-token').value = response.credential;
                document.getElementById('google-form').submit();
            }
        </script>
    }
}
