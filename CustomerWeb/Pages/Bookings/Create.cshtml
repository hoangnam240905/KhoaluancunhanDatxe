@page
@model CustomerWeb.Pages.Bookings.CreateModel
@{
    ViewData["Title"] = "Đặt xe";
}

<h2 class="mb-2">Đặt xe</h2>
<p class="text-muted mb-4">@(Model.CreatedBooking is null ? "Chọn hình thức thuê, loại xe và thông tin chuyến đi" : "Kết quả gửi yêu cầu đặt xe")</p>

<div id="booking-feedback">
@if (Model.CreatedBooking is not null)
{
    var created = Model.CreatedBooking;
    <div class="alert alert-success">
        <div class="fw-bold fs-5 mb-2">🎉 Đặt xe thành công!</div>
        <div class="row g-2">
            <div class="col-md-4"><div class="text-muted small">Mã đơn</div><div class="fw-semibold">#@created.BookingId</div></div>
            <div class="col-md-4"><div class="text-muted small">Trạng thái</div><div>@UiDisplay.BookingStatus(created.Status)</div></div>
            <div class="col-md-4"><div class="text-muted small">Loại xe</div><div>@created.VehicleTypeName</div></div>
            <div class="col-md-4"><div class="text-muted small">Hình thức</div><div>@CreateModel.RentalModeLabel(created.RentalMode)</div></div>
            <div class="col-md-4"><div class="text-muted small">Ngày bắt đầu</div><div>@UiDisplay.Rental(created.StartDate)</div></div>
            <div class="col-md-4"><div class="text-muted small">Ngày kết thúc</div><div>@UiDisplay.Rental(created.EndDate)</div></div>
        </div>
        <div class="mt-3 d-flex flex-wrap gap-2">
            <a asp-page="Details" asp-route-id="@created.BookingId" class="btn btn-primary">Xem chi tiết đơn</a>
            <a asp-page="Index" class="btn btn-outline-secondary">Danh sách đơn</a>
            <a asp-page="Create" class="btn btn-outline-primary">Đặt xe khác</a>
        </div>
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            <div class="fw-semibold">⚠️ Đặt xe không thành công</div>
            <div>@Model.ErrorMessage</div>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.InfoMessage))
    {
        <div class="alert alert-info">@Model.InfoMessage</div>
    }
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-warning">
            <div class="fw-semibold">Vui lòng kiểm tra lại thông tin đặt xe.</div>
            <div asp-validation-summary="All" class="mb-0 mt-2"></div>
        </div>
    }
    <div class="alert alert-warning d-none" id="client-validation-banner">Vui lòng kiểm tra lại thông tin.</div>
}
</div>

@if (Model.CreatedBooking is null)
{
<form method="post" asp-page="/Bookings/Create" class="row g-4" id="booking-create-form">
    <input type="hidden" asp-for="FromRecommendation" />
    <div class="col-12">
        <div class="fw-semibold mb-2">Hình thức thuê</div>
        <div class="row g-3">
            <div class="col-md-6">
                    <input class="btn-check js-quote-input" type="radio" asp-for="Input.RentalMode" value="WithDriver" id="rentalWithDriver" />
                <label class="btn btn-outline-primary w-100 text-start p-3 h-100" for="rentalWithDriver">
                    <div class="fw-bold">Có tài xế</div>
                    <div class="small fw-normal text-muted mt-1">Thuê xe kèm tài xế. Tài xế sẽ được hệ thống điều phối và phân công cho chuyến.</div>
                </label>
            </div>
            <div class="col-md-6">
                    <input class="btn-check js-quote-input" type="radio" asp-for="Input.RentalMode" value="SelfDrive" id="rentalSelfDrive" />
                <label class="btn btn-outline-primary w-100 text-start p-3 h-100" for="rentalSelfDrive">
                    <div class="fw-bold">Tự lái</div>
                    <div class="small fw-normal text-muted mt-1">Tự lái xe. Khách nhận xe và tự sử dụng trong thời gian thuê.</div>
                </label>
            </div>
        </div>
        <span asp-validation-for="Input.RentalMode" class="text-danger"></span>
    </div>

    <div class="col-12">
        <div class="fw-semibold mb-2">Loại xe</div>
        @if (!Model.VehicleTypes.Any())
        {
            <p class="text-muted mb-0">Chưa có loại xe khả dụng.</p>
        }
        else
        {
            <div class="row g-3">
                @foreach (var type in Model.VehicleTypes)
                {
                    <div class="col-md-6">
                        <input class="btn-check js-quote-input" type="radio" asp-for="Input.VehicleTypeId" value="@type.TypeId" id="vt-@type.TypeId" />
                        <label class="btn btn-outline-secondary w-100 text-start p-3 h-100" for="vt-@type.TypeId">
                            @if (!string.IsNullOrWhiteSpace(type.ImageUrl))
                            {
                                <img src="@type.ImageUrl" alt="@type.TypeName" class="img-fluid rounded mb-2" style="max-height:120px;object-fit:cover;width:100%;" />
                            }
                            <div class="fw-bold">@type.TypeName</div>
                            <div class="small text-muted">@type.SeatCapacity chỗ</div>
                            <div class="small mt-1">Catalog: @type.PricePerDay.ToString("N0") VND/ngày · @type.PricePerKm.ToString("N0") VND/km</div>
                            <div class="small text-muted">Giá đặt lấy từ báo giá máy chủ.</div>
                        </label>
                    </div>
                }
            </div>
        }
        <span asp-validation-for="Input.VehicleTypeId" class="text-danger"></span>
    </div>

    @{
        var availableVehicles = Model.Vehicles.Where(v => v.TypeId == Model.Input.VehicleTypeId).ToList();
    }
    <div class="col-12">
        <label asp-for="Input.VehicleId" class="form-label">Xe cụ thể (không bắt buộc)</label>
        <select asp-for="Input.VehicleId" class="form-select js-quote-input">
            <option value="">Để điều phối chọn sau</option>
            @foreach (var vehicle in availableVehicles)
            {
                var papers = string.IsNullOrWhiteSpace(vehicle.RegistrationNumber)
                    ? ""
                    : $" · ĐK {vehicle.RegistrationNumber}";
                var inspectStatus = vehicle.InspectionExpiryDate is DateOnly inspectDate
                    ? UiDisplay.LegalExpiry(inspectDate, DateOnly.FromDateTime(DateTime.Now))
                    : "";
                var inspection = vehicle.InspectionExpiryDate is DateOnly inspect
                    ? $" · Đăng kiểm đến {inspect:dd/MM/yyyy} ({inspectStatus})"
                    : "";
                <option value="@vehicle.VehicleId">@($"{vehicle.LicensePlate} · {vehicle.Brand} {vehicle.Model}{papers}{inspection}")</option>
            }
        </select>
        <div class="form-text">Nếu chọn xe, hệ thống sẽ giữ xe này khi bạn thanh toán cọc.</div>
        <span asp-validation-for="Input.VehicleId" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Input.StartDate" class="form-label">Ngày bắt đầu</label>
        <input asp-for="Input.StartDate" class="form-control js-quote-input" type="datetime-local"
               min="@(DateTime.Now.Date.ToString("yyyy-MM-dd") + "T00:00")"
               value="@Model.Input.StartDate.ToString("yyyy-MM-ddTHH:mm")" />
        <span asp-validation-for="Input.StartDate" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Input.EndDate" class="form-label">Ngày kết thúc</label>
        <input asp-for="Input.EndDate" class="form-control js-quote-input" type="datetime-local"
               min="@(DateTime.Now.Date.ToString("yyyy-MM-dd") + "T00:00")"
               value="@Model.Input.EndDate.ToString("yyyy-MM-ddTHH:mm")" />
        <span asp-validation-for="Input.EndDate" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Input.PickupAddress" class="form-label">Điểm đón</label>
        <input asp-for="Input.PickupAddress" class="form-control" placeholder="TP.HCM" />
        <span asp-validation-for="Input.PickupAddress" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Input.DropoffAddress" class="form-label">Điểm trả</label>
        <input asp-for="Input.DropoffAddress" class="form-control" placeholder="Vũng Tàu" />
        <span asp-validation-for="Input.DropoffAddress" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Input.EstimatedDistance" class="form-label">Quãng đường ước tính (km)</label>
        <input asp-for="Input.EstimatedDistance" class="form-control js-quote-input" type="number" step="0.1" min="0" />
        <span asp-validation-for="Input.EstimatedDistance" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Input.Notes" class="form-label">Ghi chú</label>
        <textarea asp-for="Input.Notes" class="form-control" rows="2" placeholder="Yêu cầu đặc biệt, hành lý, điểm đón..."></textarea>
    </div>
        <input type="hidden" asp-for="QuoteConfirmed" />
        <input type="hidden" asp-for="QuotedFingerprint" />

        @if (Model.Quote is not null)
        {
            var q = Model.Quote;
            var selfDrive = CreateModel.IsSelfDrive(q.RentalMode);
            <div class="col-12" id="quote-result">
                <div class="border rounded p-3 bg-light">
                    <div class="fw-bold mb-2">Báo giá từ máy chủ</div>
                    <div class="small text-muted mb-3">Giá lấy từ GET /api/bookings/quote. Trang không tự tính tổng.</div>
                    <div class="row g-2">
                        <div class="col-md-4"><div class="text-muted small">Hình thức</div><div>@(selfDrive ? "Tự lái" : "Có tài xế")</div></div>
                        <div class="col-md-4"><div class="text-muted small">Giá thuê/ngày</div><div>@q.QuotedPricePerDay.ToString("N0") VND</div></div>
                        <div class="col-md-4"><div class="text-muted small">Số ngày</div><div>@q.QuotedDays</div></div>
                        @if (selfDrive)
                        {
                            <div class="col-md-4"><div class="text-muted small">Km miễn phí</div><div>@q.IncludedKm.ToString("N0") km</div></div>
                            <div class="col-md-4"><div class="text-muted small">Km vượt ước tính</div><div>@q.ExtraKm.ToString("N0") km</div></div>
                            <div class="col-md-4"><div class="text-muted small">Phí km vượt</div><div>@q.ExtraKmPrice.ToString("N0") VND</div></div>
                        }
                        else
                        {
                            <div class="col-md-4"><div class="text-muted small">Phí tài xế</div><div>@q.DriverAmount.ToString("N0") VND</div></div>
                            <div class="col-md-4"><div class="text-muted small">Km dự kiến</div><div>@q.EstimatedDistance.ToString("N0") km</div></div>
                            <div class="col-md-4"><div class="text-muted small">Cước km</div><div>@q.DistanceAmount.ToString("N0") VND</div></div>
                        }
                        <div class="col-md-4"><div class="text-muted small">Tạm tính</div><div class="fw-bold text-primary">@q.TotalAmount.ToString("N0") VND</div></div>
                        <div class="col-md-4"><div class="text-muted small">Cọc dự kiến</div><div>@q.DepositAmount.ToString("N0") VND</div></div>
                    </div>
                </div>
            </div>
        }
        <div class="col-12 d-none" id="quote-stale">
            <div class="alert alert-warning py-2 mb-0">Thông tin đã đổi. Bấm «Xem báo giá» để tính lại tạm tính và cọc.</div>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="col-12">
                <div class="alert alert-danger mb-0">
                    <div class="fw-semibold">⚠️ Đặt xe không thành công</div>
                    <div>@Model.ErrorMessage</div>
                </div>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.InfoMessage))
        {
            <div class="col-12">
                <div class="alert alert-info mb-0">@Model.InfoMessage</div>
            </div>
        }

        <div class="col-12">
            <button type="submit" asp-page-handler="Quote" class="btn btn-outline-primary" id="btn-quote">Xem báo giá</button>
            <button type="submit" class="btn btn-primary" id="btn-submit-booking">Gửi yêu cầu đặt xe</button>
            <a asp-page="/Index" class="btn btn-outline-secondary ms-2">Quay lại</a>
        </div>
</form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var feedback = document.getElementById('booking-feedback');
            if (feedback && feedback.querySelector('.alert:not(.d-none)')) {
                feedback.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }

            var form = document.getElementById('booking-create-form');
            if (!form) return;

            var quoteBox = document.getElementById('quote-result');
            var stale = document.getElementById('quote-stale');
            var confirmed = document.querySelector('[name="QuoteConfirmed"]');
            var fingerprint = document.querySelector('[name="QuotedFingerprint"]');
            function invalidateQuote() {
                if (quoteBox) quoteBox.classList.add('d-none');
                if (stale) stale.classList.remove('d-none');
                if (confirmed) confirmed.value = 'false';
                if (fingerprint) fingerprint.value = '';
            }
            document.querySelectorAll('.js-quote-input').forEach(function (el) {
                el.addEventListener('change', invalidateQuote);
                el.addEventListener('input', invalidateQuote);
            });

            var submitBtn = document.getElementById('btn-submit-booking');
            var quoteBtn = document.getElementById('btn-quote');
            var clientBanner = document.getElementById('client-validation-banner');
            var submitting = false;
            var submitLabel = submitBtn ? submitBtn.textContent : 'Gửi yêu cầu đặt xe';

            function restoreButtons() {
                submitting = false;
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.textContent = submitLabel;
                }
                if (quoteBtn) quoteBtn.disabled = false;
            }

            function lockSubmit() {
                submitting = true;
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.textContent = 'Đang xử lý...';
                }
                if (quoteBtn) quoteBtn.disabled = true;
            }

            if (window.jQuery) {
                jQuery(form).on('invalid-form.validate', function () {
                    restoreButtons();
                    if (clientBanner) {
                        clientBanner.classList.remove('d-none');
                        clientBanner.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                });
            }

            form.addEventListener('submit', function (e) {
                if (window.jQuery && jQuery(form).valid && !jQuery(form).valid()) {
                    restoreButtons();
                    return;
                }
                var submitter = e.submitter;
                if (submitter && submitter.id === 'btn-quote') return;
                if (submitting) {
                    e.preventDefault();
                    return;
                }
                lockSubmit();
            });
        })();
    </script>
}
