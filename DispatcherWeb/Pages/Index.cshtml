@page
@model DispatcherWeb.Pages.IndexModel
@{ ViewData["Title"] = "Bang dieu phoi"; }
<h2 class="mb-4">Bang dieu phoi</h2>
@if (!string.IsNullOrEmpty(Model.Message)) { <div class="alert alert-info">@Model.Message</div> }

<h4 class="text-warning">Don cho xac nhan (@Model.PendingBookings.Count)</h4>
@if (!Model.PendingBookings.Any()) { <p class="text-muted">Khong co don pending.</p> }
else
{
    <table class="table table-sm mb-4">
        <thead><tr><th>Ma</th><th>Khach</th><th>Loai xe</th><th>Tuyen</th><th>Thoi gian</th><th></th></tr></thead>
        <tbody>
        @foreach (var b in Model.PendingBookings)
        {
            <tr>
                <td>#@b.BookingId</td><td>@b.CustomerName</td><td>@b.VehicleTypeName</td>
                <td>@b.PickupAddress → @b.DropoffAddress</td>
                <td>@b.StartDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    <form method="post" asp-page-handler="Confirm" asp-route-id="@b.BookingId" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-success">Xac nhan</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

<h4 class="text-primary">Don da xac nhan - can phan cong (@Model.ConfirmedBookings.Count)</h4>
@if (!Model.ConfirmedBookings.Any()) { <p class="text-muted">Khong co don can phan cong.</p> }
else
{
    <table class="table table-sm">
        <thead><tr><th>Ma</th><th>Khach</th><th>Loai xe</th><th>Tuyen</th><th></th></tr></thead>
        <tbody>
        @foreach (var b in Model.ConfirmedBookings)
        {
            <tr>
                <td>#@b.BookingId</td><td>@b.CustomerName</td><td>@b.VehicleTypeName</td>
                <td>@b.PickupAddress → @b.DropoffAddress</td>
                <td><a asp-page="/Assign" asp-route-id="@b.BookingId" class="btn btn-sm btn-primary">Phan cong</a></td>
            </tr>
        }
        </tbody>
    </table>
}
