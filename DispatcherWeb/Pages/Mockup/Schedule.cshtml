@page
@{
    Layout = "_MockupLayout";
    ViewData["Title"] = "Lịch xe & tài xế";
    ViewData["Nav"] = "schedule";
}
<div class="mk-banner">Giao diện mô phỏng — lịch, khoảng đệm 2 giờ và xung đột dưới đây là dữ liệu mẫu. Chưa gọi hệ thống thật.</div>

<section class="mk-hub-head">
    <div>
        <h1>Lịch xe &amp; tài xế</h1>
        <p>Theo dõi lịch sử dụng xe và phân bổ tài xế</p>
    </div>
    <div class="sch-head-actions">
        <button type="button" class="mk-btn mk-btn-ghost" id="schToday">📅 Hôm nay</button>
        <label class="mk-field sch-date-field">
            <span>Ngày</span>
            <input type="date" id="schDate" />
        </label>
        <div class="mk-pills sch-view-pills" id="schView">
            <button type="button" class="mk-pill" data-view="day">Ngày</button>
            <button type="button" class="mk-pill is-on" data-view="week">Tuần</button>
            <button type="button" class="mk-pill" data-view="month">Tháng</button>
        </div>
    </div>
</section>

<div class="mk-metrics">
    <div class="mk-metric"><span>🚗 Tổng số xe</span><strong>24</strong></div>
    <div class="mk-metric"><span>🟢 Xe khả dụng</span><strong>14</strong></div>
    <div class="mk-metric"><span>🔴 Xe đang bận</span><strong>4</strong></div>
    <div class="mk-metric"><span>👨‍✈️ Tài xế đang hoạt động</span><strong>7</strong></div>
</div>

<section class="mk-card mk-toolbar">
    <div class="sch-nav">
        <button type="button" class="mk-btn mk-btn-ghost" id="schPrev">‹ Trước</button>
        <strong id="schRange">14 – 20 Tháng 09, 2026</strong>
        <button type="button" class="mk-btn mk-btn-primary" id="schThis">Tuần này</button>
        <button type="button" class="mk-btn mk-btn-ghost" id="schNext">Sau ›</button>
    </div>
    <form id="schFilter" class="sch-filter-grid" autocomplete="off">
        <label class="mk-field">
            <span>Tìm kiếm</span>
            <input type="search" name="q" placeholder="Xe, biển số, mã đơn, khách, tài xế" />
        </label>
        <label class="mk-field">
            <span>Trạng thái xe</span>
            <select name="vstatus">
                <option value="">Tất cả</option>
                <option value="Available">Khả dụng</option>
                <option value="Busy">Đang thuê</option>
                <option value="Maintenance">Bảo trì</option>
            </select>
        </label>
        <label class="mk-field">
            <span>Hình thức</span>
            <select name="mode">
                <option value="">Tất cả</option>
                <option value="SelfDrive">Tự lái</option>
                <option value="WithDriver">Có tài xế</option>
            </select>
        </label>
        <label class="mk-field">
            <span>Tài xế</span>
            <select name="dstatus">
                <option value="">Tất cả</option>
                <option value="Available">Khả dụng</option>
                <option value="Busy">Đang bận</option>
            </select>
        </label>
        <label class="mk-field">
            <span>Xung đột</span>
            <select name="conflict">
                <option value="">Tất cả</option>
                <option value="yes">Có xung đột</option>
                <option value="no">Không xung đột</option>
            </select>
        </label>
        <div class="mk-toolbar-actions">
            <button type="submit" class="mk-btn mk-btn-primary">🔍 Tìm kiếm</button>
            <button type="reset" class="mk-btn mk-btn-ghost" id="schReset">↻ Đặt lại</button>
        </div>
    </form>
    <div class="sch-legend">
        <span><span class="sch-dot av"></span> Khả dụng</span>
        <span><span class="sch-dot busy"></span> Đang thuê</span>
        <span><span class="sch-dot prep"></span> Đang chuẩn bị</span>
        <span><span class="sch-dot conf"></span> Xung đột</span>
        <span><span class="sch-dot buf"></span> Khoảng đệm kỹ thuật 2 giờ</span>
        <span><span class="sch-dot off"></span> Ngoại tuyến / Bảo trì</span>
    </div>
</section>

<section class="mk-card sch-conflict-card" id="schConflictBox" hidden>
    <h2>⚠️ Lịch có xung đột</h2>
    <div id="schConflictList"></div>
</section>

<section class="mk-card sch-board-card">
    <div class="sch-board-title">
        <h2>Lịch xe</h2>
        <p class="mk-muted">Khối màu đặc = đơn thuê. Vùng kẻ = khoảng đệm kỹ thuật 2 giờ. Đây là dữ liệu mô phỏng.</p>
    </div>
    <div class="sch-scroll" id="schVehicleBoard"></div>
</section>

<section class="mk-card sch-board-card">
    <div class="sch-board-title">
        <h2>👨‍✈️ Lịch tài xế</h2>
        <p class="mk-muted">Lịch tài xế mô phỏng — chưa đọc phân công thật.</p>
    </div>
    <div class="sch-scroll" id="schDriverBoard"></div>
</section>

<section class="mk-card sch-board-card">
    <div class="sch-board-title">
        <h2>Trạng thái đội xe</h2>
    </div>
    <div class="mk-table-wrap sch-fleet-wrap">
        <table class="mk-table">
            <thead>
                <tr>
                    <th>Xe</th>
                    <th>Biển số</th>
                    <th>Trạng thái</th>
                    <th>Đơn hiện tại</th>
                    <th>Đến</th>
                    <th>Đi</th>
                </tr>
            </thead>
            <tbody id="schFleetBody"></tbody>
        </table>
    </div>
</section>

<aside class="mk-drawer" id="schDrawer" aria-hidden="true"></aside>
<div class="mk-toast" id="schToast"></div>

@section Scripts {
    <script src="~/js/mockup-schedule.js" asp-append-version="true"></script>
}
