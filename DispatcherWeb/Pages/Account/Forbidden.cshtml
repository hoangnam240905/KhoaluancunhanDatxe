@page
@model DispatcherWeb.Pages.Account.ForbiddenModel
@{
    ViewData["Title"] = "Không có quyền truy cập";
}
<div class="text-center py-5">
    <h2 class="mb-3">403 — Không có quyền truy cập</h2>
    <p class="text-muted mb-4">Tài khoản của bạn không được phép sử dụng khu vực điều phối.</p>
    <a class="btn btn-warning" asp-page="/Account/Login">Về trang đăng nhập</a>
</div>
