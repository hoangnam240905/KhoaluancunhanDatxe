@page
@model DispatcherWeb.Pages.Account.LoginModel
@{ ViewData["Title"] = "Đăng nhập điều phối"; }
<h2 class="mb-3">Đăng nhập điều phối</h2>
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
<form method="post" class="col-md-5">
    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label">Email</label>
        <input asp-for="Input.Email" class="form-control" autocomplete="username" />
    </div>
    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label">Mật khẩu</label>
        <input asp-for="Input.Password" type="password" class="form-control" autocomplete="current-password" />
    </div>
    <button type="submit" class="btn btn-warning">Đăng nhập</button>
</form>
<p class="mt-3 small text-muted">Demo: dispatcher@carrental.vn / Password123!</p>
