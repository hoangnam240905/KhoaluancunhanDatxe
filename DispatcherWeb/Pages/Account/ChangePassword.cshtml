@page
@model DispatcherWeb.Pages.Account.ChangePasswordModel
@{ ViewData["Title"] = "Đổi mật khẩu"; }
<h2 class="mb-3">Đổi mật khẩu</h2>
@if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }
@if (!string.IsNullOrEmpty(Model.SuccessMessage)) { <div class="alert alert-success">@Model.SuccessMessage</div> }
<form method="post" class="col-md-6">
    <div class="mb-3"><label class="form-label">Mật khẩu cũ</label><input asp-for="Input.OldPassword" class="form-control" /></div>
    <div class="mb-3"><label class="form-label">Mật khẩu mới</label><input asp-for="Input.NewPassword" class="form-control" /></div>
    <button type="submit" class="btn btn-primary">Đổi mật khẩu</button>
</form>
