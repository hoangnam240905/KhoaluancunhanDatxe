@page "{id:int}"
@model DispatcherWeb.Pages.AssignModel
@{ ViewData["Title"] = "Phan cong chuyen"; }
<h2 class="mb-3">Phan cong don #@Model.Booking?.BookingId</h2>
@if (Model.Booking is not null)
{
    <p><strong>Khach:</strong> @Model.Booking.CustomerName | <strong>Tuyen:</strong> @Model.Booking.PickupAddress → @Model.Booking.DropoffAddress</p>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }
<form method="post" class="col-md-6">
    <div class="mb-3">
        <label class="form-label">Tai xe</label>
        <select asp-for="Input.DriverId" class="form-select">
            @foreach (var d in Model.Drivers) { <option value="@d.DriverId">@d.FullName (@d.Status)</option> }
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Xe</label>
        <select asp-for="Input.VehicleId" class="form-select">
            @foreach (var v in Model.Vehicles) { <option value="@v.VehicleId">@v.LicensePlate - @v.TypeName</option> }
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Phan cong</button>
    <a asp-page="/Index" class="btn btn-secondary">Quay lai</a>
</form>
